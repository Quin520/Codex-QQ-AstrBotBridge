+    async def test_hooks_see_plugin_origin_and_same_request(self):
+        seen = []
+        provider = ScriptedProvider(
+            [LLMResponse(role="assistant", completion_text="hello")]
+        )
+        self.plugin._resolve_chat_provider = AsyncMock(return_value=provider)
+
+        async def hook(event, hook_type, *args):
+            req = event.get_extra("provider_request")
+            self.assertIsInstance(req, ProviderRequest)
+            self.assertEqual(event.get_extra("selected_provider"), "fake")
+            if args and isinstance(args[0], ProviderRequest):
+                self.assertIs(req, args[0])
+                req.model = "hook-model"
+            seen.append(hook_type)
+            return False
+
+        with patch.object(llm_module, "dispatch_event_hook", side_effect=hook):
+            response, _ = await self.plugin._generate_llm_response(
+                "test:GroupMessage:456",
+                {"proactive_prompt": "hello"},
+                [],
+                "persona",
+                0,
+                event=self.event,
+            )
+        self.assertEqual(response.completion_text, "hello")
+        self.assertEqual(len(seen), 3)
+        self.assertEqual(provider.calls[0]["model"], "hook-model")
