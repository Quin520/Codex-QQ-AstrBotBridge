@@ -0,0 +1,318 @@
+"""Validate proactive hooks, tool rounds and history scopes without network calls."""
+
+import atexit
+import importlib
+import os
+import sys
+import tempfile
+import unittest
+from copy import deepcopy
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+RUNTIME = tempfile.TemporaryDirectory(prefix="proactive-llm-test-")
+atexit.register(RUNTIME.cleanup)
+os.environ["ASTRBOT_ROOT"] = RUNTIME.name
+sys.dont_write_bytecode = True
+CORE = Path(os.environ["ASTRBOT_CORE"])
+SOURCE = CORE / "data/plugins/astrbot_plugin_proactive_chat"
+PATCHED = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(CORE))
+package = ModuleType("proactive_test")
+package.__path__ = [str(PATCHED), str(SOURCE)]
+sys.modules[package.__name__] = package
+core_package = ModuleType("proactive_test.core")
+core_package.__path__ = [str(PATCHED / "core"), str(SOURCE / "core")]
+sys.modules[core_package.__name__] = core_package
+
+from astrbot.api.provider import LLMResponse, ProviderRequest
+from astrbot.core.agent.message import TextPart
+from astrbot.core.agent.tool import FunctionTool, ToolSet
+from astrbot.core.db.po import PlatformMessageHistory
+from astrbot.core.message.components import Plain
+from astrbot.core.message.message_event_result import MessageChain
+from astrbot.core.platform.platform import PlatformStatus
+from astrbot.core.platform.platform_metadata import PlatformMetadata
+from astrbot.core.provider.provider import Provider
+from astrbot.core.star.context import Context
+from sqlalchemy.ext.asyncio import async_sessionmaker, create_async_engine
+
+llm_module = importlib.import_module("proactive_test.core.llm_adapter")
+sender_module = importlib.import_module("proactive_test.core.message_sender")
+event_module = importlib.import_module("proactive_test.core.proactive_event")
+parser_module = importlib.import_module("proactive_test.core.session_parser")
+
+
+class ScriptedProvider(Provider):
+    def __init__(self, responses):
+        super().__init__(
+            {"id": "fake", "type": "fake", "modalities": ["text", "tool_use"]}, {}
+        )
+        self.responses = list(responses)
+        self.calls = []
+
+    def get_current_key(self):
+        return ""
+
+    def set_key(self, key):
+        pass
+
+    async def get_models(self):
+        return ["fake"]
+
+    def meta(self):
+        return SimpleNamespace(id="fake", model="fake")
+
+    async def text_chat(self, **kwargs):
+        self.calls.append(
+            deepcopy(
+                {
+                    key: kwargs[key]
+                    for key in (
+                        "prompt",
+                        "contexts",
+                        "model",
+                        "extra_user_content_parts",
+                        "tool_calls_result",
+                    )
+                    if key in kwargs
+                }
+            )
+        )
+        response = self.responses.pop(0)
+        if isinstance(response, Exception):
+            raise response
+        return response
+
+
+class Harness(
+    parser_module.SessionMixin, llm_module.LlmMixin, sender_module.SenderMixin
+):
+    def __init__(self, platform_id="test", platform_name="aiocqhttp"):
+        self.context = Context.__new__(Context)
+        self.context.get_config = lambda **kwargs: {}
+        self.context.platform_manager = SimpleNamespace(
+            get_insts=lambda: [
+                SimpleNamespace(
+                    meta=lambda: PlatformMetadata(
+                        name=platform_name, description="test", id=platform_id
+                    ),
+                    status=PlatformStatus.RUNNING,
+                )
+            ]
+        )
+        self.session_data = {}
+        self.telemetry = None
+        self.data_dir = RUNTIME.name
+        from zoneinfo import ZoneInfo
+
+        self.timezone = ZoneInfo("Asia/Shanghai")
+
+    def _get_session_config(self, sid):
+        return {}
+
+
+def tool_response(value=1):
+    return LLMResponse(
+        role="tool",
+        completion_text="",
+        tools_call_name=["echo"],
+        tools_call_args=[{"value": value}],
+        tools_call_ids=[f"call-{value}"],
+    )
+
+
+class ProactiveLlmTests(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        self.plugin = Harness()
+        self.event = event_module.build_proactive_event_for_session(
+            plugin=self.plugin, session_id="test:GroupMessage:456"
+        )
+
+    def request(self, handler):
+        return ProviderRequest(
+            prompt="hello",
+            model="override-model",
+            system_prompt="persona",
+            extra_user_content_parts=[TextPart(text="temporary").mark_as_temp()],
+            func_tool=ToolSet(
+                tools=[
+                    FunctionTool(
+                        name="echo",
+                        description="echo",
+                        parameters={
+                            "type": "object",
+                            "properties": {"value": {"type": "integer"}},
+                            "required": ["value"],
+                        },
+                        handler=handler,
+                    )
+                ]
+            ),
+        )
+
+    async def test_actual_tool_executor_runs_two_rounds_and_preserves_request(self):
+        calls = []
+
+        async def echo(event, value):
+            self.assertIs(event, self.event)
+            calls.append(value)
+            return f"echo-{value}"
+
+        provider = ScriptedProvider(
+            [
+                tool_response(1),
+                tool_response(2),
+                LLMResponse(role="assistant", completion_text="done"),
+            ]
+        )
+        req = self.request(echo)
+        response = await self.plugin._invoke_provider(provider, req, self.event)
+        self.assertEqual(response.completion_text, "done")
+        self.assertEqual(calls, [1, 2])
+        self.assertEqual(len(provider.calls), 3)
+        self.assertTrue(
+            all(call["model"] == "override-model" for call in provider.calls)
+        )
+        self.assertIn("temporary", str(provider.calls[0]))
+        self.assertIn("echo-1", str(provider.calls[1]))
+        self.assertIn("echo-2", str(provider.calls[2]))
+        self.assertFalse(self.event.proactive_sent_chains)
+
+    async def test_tool_failure_is_returned_to_model_without_claimed_success(self):
+        async def broken(event, value):
+            raise ValueError("fixture tool failed")
+
+        provider = ScriptedProvider(
+            [
+                tool_response(),
+                LLMResponse(role="assistant", completion_text="tool failed"),
+            ]
+        )
+        result = await self.plugin._invoke_provider(
+            provider, self.request(broken), self.event
+        )
