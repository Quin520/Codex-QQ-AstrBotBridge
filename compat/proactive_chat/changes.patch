+"""Exercise shared group scheduling with real AstrBot events and timers."""
+
+from __future__ import annotations
+
+import asyncio
+import importlib.util
+import os
+import tempfile
+import time
+import unittest
+from datetime import UTC
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+_runtime = tempfile.TemporaryDirectory()
+os.environ.setdefault("ASTRBOT_ROOT", _runtime.name)
+
+from apscheduler.schedulers.asyncio import AsyncIOScheduler
+from astrbot.core.message.components import Plain
+from astrbot.core.platform.astr_message_event import AstrMessageEvent
+from astrbot.core.platform.astrbot_message import (
+    AstrBotMessage,
+    Group,
+    MessageMember,
+)
+from astrbot.core.platform.message_type import MessageType
+from astrbot.core.platform.platform import PlatformStatus
+from astrbot.core.platform.platform_metadata import PlatformMetadata
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def load(name: str):
+    spec = importlib.util.spec_from_file_location(name, ROOT / "core" / f"{name}.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+class Harness(
+    load("session_parser").SessionMixin,
+    load("data_storage").StorageMixin,
+    load("session_config").ConfigMixin,
+    load("task_scheduler").SchedulerMixin,
+    load("message_events").EventsMixin,
+    load("plugin_lifecycle").LifecycleMixin,
+):
+    def _track_task(self, task):
+        self.tasks.add(task)
+        return task
+
+    async def check_and_chat(self, session_id):
+        raise AssertionError("Tests must never dispatch a message")
+
+
+def event(sender: str, group: str = "456") -> AstrMessageEvent:
+    message = AstrBotMessage()
+    message.type = MessageType.GROUP_MESSAGE
+    message.group = Group(group_id=group)
+    message.sender = MessageMember(user_id=sender, nickname=f"Member-{sender}")
+    message.self_id = "321"
+    message.message = [Plain("hello")]
+    message.message_id = "test"
+    message.message_str = "hello"
+    return AstrMessageEvent(
+        "hello",
+        message,
+        PlatformMetadata("aiocqhttp", "test", "test"),
+        f"{sender}_{group}",
+    )
+
+
+class GroupSchedulingTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.plugin = p = Harness()
+        p.context = SimpleNamespace(
+            platform_manager=SimpleNamespace(
+                get_insts=lambda: [
+                    SimpleNamespace(
+                        meta=lambda: PlatformMetadata("aiocqhttp", "test", "test"),
+                        status=PlatformStatus.RUNNING,
+                    ),
+                    SimpleNamespace(
+                        meta=lambda: PlatformMetadata("slack", "other", "other"),
+                        status=PlatformStatus.RUNNING,
+                    ),
+                ]
+            )
+        )
+        p.config = {
+            "group_settings": {
+                "enable": True,
+                "session_list": ["456"],
+                "group_idle_trigger_minutes": 30,
+                "auto_trigger_settings": {
+                    "enable_auto_trigger": True,
+                    "auto_trigger_after_minutes": 15,
+                },
+                "schedule_settings": {
+                    "min_interval_minutes": 90,
+                    "max_interval_minutes": 90,
+                },
+            }
+        }
+        p.session_override_manager = None
+        p.session_data = {}
+        p.last_message_times = {}
+        p.session_temp_state = {}
+        p.first_message_logged = set()
+        p.group_timers = {}
+        p.auto_trigger_timers = {}
+        p.tasks = set()
+        p._cleanup_counter = 0
+        p.data_lock = asyncio.Lock()
+        p._save_data_internal = AsyncMock()
+        p.plugin_start_time = time.time() - 1
+        p.timezone = UTC
+        p.scheduler = AsyncIOScheduler(timezone=UTC)
+        p.scheduler.start(paused=True)
+        p._terminating = False
+        p._startup_task = p._heartbeat_task = None
+        p.telemetry = p.web_admin_server = p.notification_center = None
+        p._exception_handler_installed = False
+
+    async def asyncTearDown(self):
+        if not self.plugin._terminating:
+            await self.plugin.terminate()
+        for task in self.plugin.tasks:
+            if not task.done():
+                task.cancel()
+        await asyncio.gather(*self.plugin.tasks, return_exceptions=True)
+        await asyncio.sleep(0)
+
+    async def test_members_share_timer_without_changing_chat_isolation(self):
+        p = self.plugin
+        key = "test:GroupMessage:456"
+        await p._setup_auto_trigger(key)
+        auto_timer = p.auto_trigger_timers[key]
+        first = event("123")
+        await p.on_group_message(first)
+        first_timer = p.group_timers[key]
+        self.assertTrue(auto_timer.cancelled())
+        self.assertEqual(first.unified_msg_origin, "test:GroupMessage:123_456")
+        second = event("999")
+        await p.on_group_message(second)
+        self.assertTrue(first_timer.cancelled())
+        self.assertEqual(set(p.group_timers), {key})
+        self.assertEqual(set(p.session_data), {key})
+        self.assertEqual(p.session_data[key]["last_sender_id"], "999")
+        self.assertEqual(second.unified_msg_origin, "test:GroupMessage:999_456")
+
+        await p._handle_group_silence_callback(key, 30)
+        await asyncio.gather(*p.tasks)
+        self.assertEqual([job.id for job in p.scheduler.get_jobs()], [key])
+        self.assertEqual(p.scheduler.get_job(key).args, (key,))
+        await p.on_group_message(event("123"))
+        self.assertEqual(p.scheduler.get_jobs(), [])
+        self.assertNotIn("next_trigger_time", p.session_data[key])
+        self.assertEqual(p.session_data[key]["unanswered_count"], 0)
+
+    async def test_unconfigured_group_and_bot_do_not_start_timers(self):
+        await self.plugin.on_group_message(event("123", "999"))
+        await self.plugin.on_group_message(event("321"))
+        self.assertEqual(self.plugin.group_timers, {})
+        self.assertEqual(self.plugin.scheduler.get_jobs(), [])
+
+    async def test_bot_reply_resets_same_shared_timer(self):
+        p = self.plugin
+        await p.on_group_message(event("123"))
+        key = "test:GroupMessage:456"
+        previous = p.group_timers[key]
+        await p.on_after_message_sent(event("999"))
+        self.assertTrue(previous.cancelled())
+        self.assertEqual(set(p.group_timers), {key})
+
+    async def test_migration_preserves_latest_speaker_in_either_order(self):
+        p = self.plugin
+        for entries in [
+            [("123", 10, "Alpha"), ("999", 20, "Beta")],
+            [("999", 20, "Beta"), ("123", 10, "Alpha")],
+        ]:
+            p.session_data = {
+                f"test:GroupMessage:{sender}_456": {
+                    "last_message_time": stamp,
+                    "last_sender_id": sender,
+                    "last_sender_name": name,
+                    "self_id": "321",
+                }
+                for sender, stamp, name in entries
+            }
+            self.assertTrue(p._normalize_session_data())
+            self.assertEqual(list(p.session_data), ["test:GroupMessage:456"])
+            merged = p.session_data["test:GroupMessage:456"]
+            self.assertEqual(merged["last_message_time"], 20)
+            self.assertEqual(merged["last_sender_id"], "999")
+            self.assertEqual(merged["last_sender_name"], "Beta")
+            self.assertFalse(p._normalize_session_data())
+
+    async def test_non_onebot_and_private_ids_are_unchanged(self):
+        for key in (
+            "other:GroupMessage:123_456",
+            "test:FriendMessage:123_456",
+            "test:GuildMessage:123_456",
+            "test:GroupMessage:a_b",
+            "test:GroupMessage:123_456_999",
+            "test:GroupMessage:456",
+        ):
+            self.assertEqual(self.plugin._normalize_session_id(key), key)
+
+    async def test_disable_cancels_timers_and_blocks_late_callbacks(self):
+        p = self.plugin
+        key = "test:GroupMessage:456"
+        await p.on_group_message(event("123"))
+        timer = p.group_timers[key]
+        await p._schedule_next_chat_and_save(key)
+        self.assertEqual(len(p.scheduler.get_jobs()), 1)
+        await p.terminate()
+        self.assertTrue(timer.cancelled())
+        self.assertEqual(p.group_timers, {})
+        self.assertEqual(p.scheduler.get_jobs(), [])
+        await p._handle_group_silence_callback(key, 30)
+        await p._handle_auto_trigger_callback(key, 15)
+        await p._schedule_next_chat_and_save(key)
+        self.assertEqual(p.scheduler.get_jobs(), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
