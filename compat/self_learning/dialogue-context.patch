+"""Preserve configured Codex persona without altering background learning calls.
+
+Uses the companion proactive identity test's isolated AstrBot setup. Set
+SELF_LEARNING_DIVERSITY_FILE to validate a staged diversity manager.
+"""
+
+import importlib
+import importlib.util
+import os
+import sys
+import unittest
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+from unittest.mock import AsyncMock
+
+import test_bridge_proactive_social as fixture
+
+BRIDGE_NAME = "data.plugins.astrbot_plugin_local_codex"
+bridge_path = Path(
+    os.environ.get(
+        "CODEX_BRIDGE_PLUGIN_DIR", fixture.PLUGIN.parent / "astrbot_plugin_local_codex"
+    )
+)
+package = ModuleType(BRIDGE_NAME)
+package.__path__ = [str(bridge_path)]
+sys.modules[BRIDGE_NAME] = package
+bridge_module = importlib.import_module(BRIDGE_NAME + ".main")
+
+DIVERSITY_NAME = fixture.SELF_MODULE + ".services.response.response_diversity_manager"
+if override := os.environ.get("SELF_LEARNING_DIVERSITY_FILE"):
+    spec = importlib.util.spec_from_file_location(DIVERSITY_NAME, override)
+    diversity_module = importlib.util.module_from_spec(spec)
+    sys.modules[DIVERSITY_NAME] = diversity_module
+    spec.loader.exec_module(diversity_module)
+else:
+    diversity_module = importlib.import_module(DIVERSITY_NAME)
+
+
+class NaturalStyleTests(unittest.IsolatedAsyncioTestCase):
+    event = fixture.ProactiveSocialTests.event
+    run_hook = fixture.ProactiveSocialTests.run_hook
+
+    def setUp(self):
+        fixture.ProactiveSocialTests.setUp(self)
+        self.bridge = bridge_module.LocalCodex.__new__(bridge_module.LocalCodex)
+        self.bridge.config = {
+            "integrate_plugins": True,
+            "natural_chat_enabled": True,
+            "owner_qq": "123",
+            "group_qq": "456",
+        }
+        self.star = SimpleNamespace(activated=True, star_cls=self.bridge)
+        self.hook._context = SimpleNamespace(get_registered_star=lambda name: self.star)
+        self.database = SimpleNamespace(
+            get_recent_bot_responses=AsyncMock(return_value=["PREVIOUS_OPENING"])
+        )
+        self.diversity = diversity_module.ResponseDiversityManager(
+            SimpleNamespace(), self.database
+        )
+        self.diversity._enable_protection = False
+        self.diversity.get_random_language_style = lambda: "RANDOM_STYLE"
+        self.diversity.get_random_response_pattern = lambda: "RANDOM_PATTERN"
+        self.diversity.get_expression_variation = lambda: {
+            "sentence_style": "RANDOM_SENTENCE",
+            "tone": "RANDOM_TONE",
+            "emphasis": "RANDOM_EMPHASIS",
+        }
+        self.hook._diversity_manager = self.diversity
+
+    def assert_stable(self, text):
+        self.assertIn("PREVIOUS_OPENING", text)
+        self.assertNotIn("RANDOM_", text)
+
+    async def test_authorized_group_retains_history_without_random_persona(self):
+        text = await self.run_hook(self.event(ordinary_type=fixture.AstrMessageEvent))
+        self.assert_stable(text)
+        self.assertIn("MEMBER_AFFECTION", text)
+        self.database.get_recent_bot_responses.assert_awaited_once_with("456", limit=5)
+
+    async def test_owner_private_and_proactive_group_use_stable_style(self):
+        private = self.event(
+            group=False, sender="123", ordinary_type=fixture.AstrMessageEvent
+        )
+        self.assert_stable(await self.run_hook(private))
+        self.assert_stable(await self.run_hook(self.event(sender="")))
+
+    async def test_switch_off_or_integration_off_preserves_existing_style(self):
+        for key in ("natural_chat_enabled", "integrate_plugins"):
+            with self.subTest(key=key):
+                self.bridge.config[key] = False
+                text = await self.run_hook(
+                    self.event(ordinary_type=fixture.AstrMessageEvent)
+                )
+                self.assertIn("RANDOM_STYLE", text)
+                self.assertIn("RANDOM_PATTERN", text)
+                self.bridge.config[key] = True
+
+    async def test_outside_group_and_untrusted_private_keep_existing_style(self):
+        events = [
+            self.event(
+                group=False, sender="999", ordinary_type=fixture.AstrMessageEvent
+            )
+        ]
+        outside = self.event(ordinary_type=fixture.AstrMessageEvent)
+        outside.message_obj.group.group_id = "777"
+        events.append(outside)
+        foreign = self.event(ordinary_type=fixture.AstrMessageEvent)
+        foreign.platform_meta.name = "telegram"
+        events.append(foreign)
+        for event in events:
+            with self.subTest(
+                group=event.get_group_id(), platform=event.get_platform_name()
+            ):
+                self.assertIn("RANDOM_STYLE", await self.run_hook(event))
+
+    async def test_missing_inactive_or_lookalike_bridge_cannot_change_style(self):
+        event = self.event(ordinary_type=fixture.AstrMessageEvent)
+        self.star.activated = False
+        self.assertIn("RANDOM_STYLE", await self.run_hook(event))
+        self.star.activated = True
+        lookalike = type("LocalCodex", (), {"__module__": BRIDGE_NAME + ".main"})()
+        lookalike.config = self.bridge.config
+        self.star.star_cls = lookalike
+        self.assertIn("RANDOM_STYLE", await self.run_hook(event))
+        self.star = None
+        self.assertIn("RANDOM_STYLE", await self.run_hook(event))
+
+    async def test_changing_switch_does_not_reuse_opposite_style_cache(self):
+        event = self.event(ordinary_type=fixture.AstrMessageEvent)
+        self.bridge.config["natural_chat_enabled"] = False
+        self.assertIn("RANDOM_STYLE", await self.run_hook(event))
+        self.bridge.config["natural_chat_enabled"] = True
+        self.assert_stable(await self.run_hook(event))
+        self.bridge.config["natural_chat_enabled"] = False
+        self.assertIn("RANDOM_STYLE", await self.run_hook(event))
+        self.assertEqual(self.database.get_recent_bot_responses.await_count, 2)
+
+    async def test_background_json_learning_keeps_its_own_prompt_and_format(self):
+        adapter_type = importlib.import_module(
+            fixture.SELF_MODULE + ".core.framework_llm_adapter"
+        ).FrameworkLLMAdapter
+        adapter = adapter_type(self.hook._context)
+        provider = SimpleNamespace(
+            meta=lambda: SimpleNamespace(id="local_codex"),
+            text_chat=AsyncMock(
+                return_value=SimpleNamespace(completion_text='{"changes":[]}')
+            ),
+        )
+        adapter.filter_provider = provider
+        result = await adapter.filter_chat_completion(
+            prompt="Analyze fictional preference evidence.",
+            contexts=[],
+            system_prompt="Return only review JSON.",
+            response_format={"type": "json_object"},
+        )
+        self.assertEqual(result, '{"changes":[]}')
+        provider.text_chat.assert_awaited_once_with(
+            prompt="Analyze fictional preference evidence.",
+            contexts=[],
+            system_prompt="Return only review JSON.",
+            response_format={"type": "json_object"},
+        )
+        self.database.get_recent_bot_responses.assert_not_awaited()
+
+
+if __name__ == "__main__":
+    unittest.main()
