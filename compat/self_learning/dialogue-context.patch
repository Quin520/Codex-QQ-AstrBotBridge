+"""Keep proactive group context distinct from the last member's relationship.
+
+Run with the AstrBot Python environment and PYTHONPATH pointing at its core.
+SELF_LEARNING_PLUGIN_DIR and PROACTIVE_PLUGIN_DIR can select installed plugins;
+SELF_LEARNING_HOOK_FILE can select a staged handler for pre-deployment checks.
+No model calls, platform sends, or conversation database writes are performed.
+"""
+
+import importlib
+import importlib.util
+import os
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+from unittest.mock import AsyncMock
+
+RUNTIME = tempfile.TemporaryDirectory(prefix="proactive-social-test-")
+os.environ["ASTRBOT_ROOT"] = RUNTIME.name
+PLUGIN = Path(
+    os.environ.get("SELF_LEARNING_PLUGIN_DIR", Path(__file__).resolve().parents[1])
+)
+PROACTIVE = Path(
+    os.environ.get(
+        "PROACTIVE_PLUGIN_DIR", PLUGIN.parent / "astrbot_plugin_proactive_chat"
+    )
+)
+SELF_MODULE = "data.plugins.astrbot_plugin_self_learning"
+PROACTIVE_MODULE = "data.plugins.astrbot_plugin_proactive_chat"
+for name, directory in ((SELF_MODULE, PLUGIN), (PROACTIVE_MODULE, PROACTIVE)):
+    package = ModuleType(name)
+    package.__path__ = [str(directory)]
+    sys.modules[name] = package
+
+HOOK_MODULE = SELF_MODULE + ".services.hooks.llm_hook_handler"
+if override := os.environ.get("SELF_LEARNING_HOOK_FILE"):
+    spec = importlib.util.spec_from_file_location(HOOK_MODULE, override)
+    hook_module = importlib.util.module_from_spec(spec)
+    sys.modules[HOOK_MODULE] = hook_module
+    spec.loader.exec_module(hook_module)
+else:
+    hook_module = importlib.import_module(HOOK_MODULE)
+
+from astrbot.api.provider import ProviderRequest
+from astrbot.core.platform.astr_message_event import AstrMessageEvent
+from astrbot.core.platform.message_type import MessageType
+from astrbot.core.platform.platform_metadata import PlatformMetadata
+
+SocialContextInjector = importlib.import_module(
+    SELF_MODULE + ".services.social.social_context_injector"
+).SocialContextInjector
+proactive_module = importlib.import_module(PROACTIVE_MODULE + ".core.proactive_event")
+
+
+class ProactiveSocialTests(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        self.config = SimpleNamespace(
+            enable_llm_hooks=True,
+            enable_command_pass_through=True,
+            enable_social_context_injection=True,
+            include_social_relations=True,
+            include_affection_info=True,
+            enable_expression_patterns=True,
+            enable_goal_driven_chat=True,
+        )
+        self.social = SocialContextInjector(
+            database_manager=None,
+            affection_manager=object(),
+            psychological_state_manager=object(),
+            goal_manager=object(),
+        )
+        self.social._enable_protection = False
+        for name, marker in (
+            ("_build_psychological_context", "GROUP_PSYCHOLOGY"),
+            ("_format_expression_patterns_context", "GROUP_EXPRESSIONS"),
+            ("_format_affection_context", "MEMBER_AFFECTION"),
+            ("format_social_context", "MEMBER_RELATIONSHIPS"),
+            ("_build_behavior_guidance", "MEMBER_BEHAVIOR"),
+            ("_format_conversation_goal_context", "MEMBER_GOAL"),
+        ):
+            setattr(self.social, name, AsyncMock(return_value=marker))
+        self.diversity = SimpleNamespace(
+            build_diversity_prompt_injection=AsyncMock(return_value="GROUP_STYLE"),
+            get_current_style=lambda: "default",
+            get_current_pattern=lambda: "chat",
+        )
+        self.hook = hook_module.LLMHookHandler(
+            self.config,
+            self.diversity,
+            self.social,
+            None,
+            None,
+            None,
+            SimpleNamespace(record=lambda value: None),
+            {},
+        )
+
+    def event(self, group=True, sender="999", ordinary_type=None):
+        event = proactive_module.ProactiveMessageEvent(
+            plugin=None,
+            platform_meta=PlatformMetadata(
+                name="aiocqhttp", description="fixture", id="test"
+            ),
+            session_id="test:GroupMessage:456" if group else "test:FriendMessage:999",
+            target_id="456" if group else "999",
+            message_type=MessageType.GROUP_MESSAGE
+            if group
+            else MessageType.FRIEND_MESSAGE,
+            self_id="321",
+            sender_id=sender,
+            sender_name="Fixture member",
+            is_group=group,
+        )
+        if ordinary_type:
+            return ordinary_type(
+                "hello", event.message_obj, event.platform_meta, event.session_id
+            )
+        return event
+
+    async def run_hook(self, event):
+        request = ProviderRequest(prompt="Start a group conversation.")
+        await self.hook.handle(event, request)
+        return "\n".join(
+            part.text
+            for part in request.extra_user_content_parts
+            if hasattr(part, "text")
+        )
+
+    async def test_real_proactive_group_retains_group_context_without_last_member(self):
+        text = await self.run_hook(self.event())
+        for marker in ("GROUP_PSYCHOLOGY", "GROUP_EXPRESSIONS", "GROUP_STYLE"):
+            self.assertIn(marker, text)
+        for name in (
+            "_format_affection_context",
+            "format_social_context",
+            "_build_behavior_guidance",
+            "_format_conversation_goal_context",
+        ):
+            getattr(self.social, name).assert_not_awaited()
+        self.assertNotIn("MEMBER_", text)
+        self.assertEqual(
+            self.social._format_expression_patterns_context.call_args.kwargs["user_id"],
+            "",
+        )
+
+    async def test_real_proactive_group_without_member_hint_has_group_context(self):
+        text = await self.run_hook(self.event(sender=""))
+        self.assertIn("GROUP_PSYCHOLOGY", text)
+        self.assertNotIn("MEMBER_", text)
+
+    async def test_proactive_private_event_retains_real_recipient(self):
+        text = await self.run_hook(self.event(group=False))
+        self.assertIn("MEMBER_AFFECTION", text)
+        self.social._format_affection_context.assert_awaited_once_with("999", "999")
+
+    async def test_ordinary_group_still_uses_current_sender(self):
+        text = await self.run_hook(self.event(ordinary_type=AstrMessageEvent))
+        self.assertIn("MEMBER_RELATIONSHIPS", text)
+        self.social._format_affection_context.assert_awaited_once_with("456", "999")
+
+    async def test_extra_flags_cannot_claim_proactive_identity(self):
+        event = self.event(ordinary_type=AstrMessageEvent)
+        event.set_extra("proactive", True)
+        event.set_extra("plugin_llm_request", True)
+        event._proactive_is_group = True
+        text = await self.run_hook(event)
+        self.assertIn("MEMBER_AFFECTION", text)
+
+    async def test_same_class_name_and_module_are_not_the_registered_event_type(self):
+        spoof = type(
+            "ProactiveMessageEvent",
+            (AstrMessageEvent,),
+            {
+                "__module__": PROACTIVE_MODULE + ".core.proactive_event",
+            },
+        )
+        text = await self.run_hook(self.event(ordinary_type=spoof))
+        self.assertIn("MEMBER_AFFECTION", text)
+
+    async def test_social_switch_still_disables_group_context(self):
+        self.config.enable_social_context_injection = False
+        text = await self.run_hook(self.event())
+        self.assertNotIn("GROUP_PSYCHOLOGY", text)
+        self.social._build_psychological_context.assert_not_awaited()
+        self.assertIn("GROUP_STYLE", text)
+
+
+if __name__ == "__main__":
+    unittest.main()
