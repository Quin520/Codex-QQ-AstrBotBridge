+import { fireEvent, render, screen, waitFor } from '@solidjs/testing-library';
+import { beforeEach, expect, it, vi } from 'vitest';
+import { LearningApprovalPanel } from './LearningApprovalPanel';
+
+const mocks = vi.hoisted(() => ({ get: vi.fn(), post: vi.fn(), confirm: vi.fn(), toast: vi.fn() }));
+vi.mock('../../services/api', () => ({ api: { get: mocks.get, post: mocks.post } }));
+vi.mock('../../stores/dashboard', () => ({ useDashboard: () => ({
+  lastUpdated: () => null, confirm: mocks.confirm, toast: mocks.toast,
+}) }));
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  mocks.confirm.mockResolvedValue(true);
+  mocks.post.mockResolvedValue({ success: true });
+  mocks.get.mockImplementation(async (path: string) => path.includes('learning_approval_status')
+    ? { require_approval: true, learning_interval_hours: 6, min_messages: 50, groups: [] }
+    : { reviews: [{ id: 7, user_id: '123', group_id: '456', before: 10, after: 15,
+      change: 5, reason: '友善互动', message: '辛苦啦', status: 'pending', created_at: 1700000000 }] });
+});
+
+it('shows evidence and sends an explicit approval for the selected change', async () => {
+  render(() => <LearningApprovalPanel />);
