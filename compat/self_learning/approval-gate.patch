+class ApprovalGateTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.config = PluginConfig(data_dir=self.temp.name, db_type="sqlite", enable_web_interface=False)
+        self.db = SQLAlchemyDatabaseManager(self.config)
+        self.assertTrue(await self.db.start())
+        self.config.require_learning_approval = True
+        self.affection = AffectionReviewService(self.db, self.config)
+
+    async def asyncTearDown(self):
+        await self.db.stop()
+        self.temp.cleanup()
+
+    async def count(self, model):
+        async with self.db.get_session() as session:
+            return len((await session.scalars(select(model))).all())
+
+    async def proposal(self, user="123", before=0, after=5):
+        return await self.affection.propose("group-a", user, before, after, "praise", "友善互动", "辛苦啦", "calm")
+
+    async def test_affection_waits_for_approval_and_records_actual_change(self):
+        review_id = await self.proposal()
+        self.assertIsNone(await self.db.get_user_affection("group-a", "123"))
+        self.assertEqual(await self.count(AffectionInteraction), 0)
+        self.assertTrue((await self.affection.decide(review_id, "approve"))[0])
+        self.assertEqual((await self.db.get_user_affection("group-a", "123"))["affection_level"], 5)
+        history = await self.db.get_affection_history("group-a", "123")
+        self.assertEqual((history[0]["previous_level"], history[0]["new_level"]), (0, 5))
+        self.assertEqual(history[0]["message"], "辛苦啦")
+        self.assertEqual(await self.db.get_affection_history("group-b"), [])
+        self.assertFalse((await self.affection.decide(review_id, "approve"))[0])
+        self.assertEqual(await self.count(AffectionInteraction), 1)
+
+    async def test_rejection_and_duplicate_and_zero_changes(self):
+        first = await self.proposal()
+        self.assertEqual(first, await self.proposal())
+        self.assertEqual(await self.proposal(after=0), 0)
+        self.assertTrue((await self.affection.decide(first, "reject"))[0])
+        self.assertEqual(await self.count(UserAffection), 0)
+        self.assertEqual(await self.count(AffectionInteraction), 0)
+
