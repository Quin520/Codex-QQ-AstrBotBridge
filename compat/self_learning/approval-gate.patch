+"""Persist learned examples only after review, preserving group/persona/user scope."""
+
+import json
+import time
+from datetime import datetime
+
+from sqlalchemy import select
+
+from ...constants import UPDATE_TYPE_STYLE_LEARNING
+from ...models.orm.expression import ExpressionPattern
+from ...models.orm.learning import StyleLearningReview
+from ...utils.persona_selection import normalize_persona_scope
+
+
+def pattern_key(pattern: dict, persona_id: str = "default") -> tuple:
+    return (
+        normalize_persona_scope(pattern.get("persona_id"), fallback=persona_id),
+        pattern.get("user_id") or None,
+        str(pattern.get("situation", "")).strip(),
+        str(pattern.get("expression", "")).strip(),
+    )
+
+
+async def queue_patterns(db, group_id: str, patterns: list[dict],
+                         persona_id: str = "default", source: str = "learning",
+                         *, include_active: bool = False) -> int:
+    """Deduplicate proposals against active and already reviewed examples."""
+    from .expression_learning import ExpressionLearningModule
+
+    patterns = ExpressionLearningModule.filter_expression_patterns(patterns)
+    async with db.get_session() as session:
+        count = await queue_patterns_in_session(
+            session, group_id, patterns, persona_id, source, include_active=include_active
+        )
+        await session.commit()
+        return count
+
+
+async def queue_patterns_in_session(session, group_id: str, patterns: list[dict],
+                                    persona_id: str, source: str,
+                                    *, include_active: bool = False) -> int:
+    """Queue all valid examples in reviewable chunks; caller owns the transaction."""
+    known = set()
+    reviews = await session.scalars(select(StyleLearningReview).where(
+        StyleLearningReview.group_id == group_id
+    ))
+    for review in reviews:
+        for pattern in json.loads(review.learned_patterns or "[]"):
+            if isinstance(pattern, dict):
+                known.add(pattern_key(pattern))
+    if not include_active:
+        active = await session.scalars(select(ExpressionPattern).where(
+            ExpressionPattern.group_id == group_id
+        ))
+        known.update((p.persona_id, p.user_id, p.situation, p.expression) for p in active)
+    fresh = []
+    for pattern in patterns:
+        key = pattern_key(pattern, persona_id)
+        if not key[2] or not key[3] or key in known:
+            continue
+        known.add(key)
+        fresh.append({**pattern, "persona_id": key[0], "user_id": key[1]})
+    for offset in range(0, len(fresh), 10):
+        batch = fresh[offset:offset + 10]
+        now = time.time()
+        session.add(StyleLearningReview(
+            type=UPDATE_TYPE_STYLE_LEARNING, group_id=group_id, timestamp=now,
+            learned_patterns=json.dumps(batch, ensure_ascii=False), status="pending",
+            few_shots_content="\n\n".join(
+                f"A: {p['situation']}\nB: {p['expression']}" for p in batch
+            ),
+            description=f"待批准的表达样例（{len(batch)} 条，来源：{source}）",
+            metadata_=json.dumps({"source": source, "approval_gated": True}),
+            created_at=datetime.fromtimestamp(now), updated_at=datetime.fromtimestamp(now),
+        ))
+    await session.flush()
+    return len(fresh)
+
+
+async def apply_patterns_in_session(session, review) -> None:
+    """Activate the approved examples in the same transaction as review status."""
+    patterns = json.loads(review.learned_patterns or "[]")
+    for pattern in patterns:
+        if not isinstance(pattern, dict):
+            continue
+        persona_id, user_id, situation, expression = pattern_key(pattern)
+        if not situation or not expression:
+            continue
+        existing = await session.scalar(select(ExpressionPattern.id).where(
+            ExpressionPattern.group_id == review.group_id,
+            ExpressionPattern.persona_id == persona_id,
+            ExpressionPattern.user_id == user_id,
+            ExpressionPattern.situation == situation,
+            ExpressionPattern.expression == expression,
+        ))
+        if existing:
+            continue
+        now = time.time()
+        session.add(ExpressionPattern(
+            group_id=review.group_id, persona_id=persona_id, user_id=user_id,
+            situation=situation, expression=expression,
+            weight=float(pattern.get("weight", 1.0)),
+            last_active_time=now, create_time=now,
+        ))
