+++ b/tests/integration/test_profile_review_access.py
@@ -0,0 +1,32 @@
+"""Passwordless profile reviews must stay local; password mode still authenticates."""
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from webui.compat import Quart
+from webui.blueprints import persona_reviews
+from webui.middleware import auth
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("address,enabled,status", [
+    ("127.0.0.1", False, 200),
+    ("::1", False, 200),
+    ("198.51.100.10", False, 403),
+    ("127.0.0.1", True, 401),
+    ("198.51.100.10", True, 401),
+])
+async def test_profile_review_access(monkeypatch, address, enabled, status):
+    container = SimpleNamespace(plugin_config=SimpleNamespace(enable_webui_password=enabled))
+    monkeypatch.setattr(persona_reviews, "get_container", lambda: container)
+    monkeypatch.setattr(auth, "get_container", lambda: container)
+    service = SimpleNamespace(get_pending_persona_updates=AsyncMock(return_value={"success": True, "updates": []}))
+    monkeypatch.setattr(persona_reviews, "PersonaReviewService", lambda _: service)
+    app = Quart("profile-review-access-test")
+    app.register_blueprint(persona_reviews.persona_reviews_bp)
+    client = app.test_client(client=(address, 50000))
+    response = await client.get("/api/persona_updates")
+    assert response.status_code == status
+    if status != 200:
+        service.get_pending_persona_updates.assert_not_awaited()
