@@ -0,0 +1,54 @@
+import { cleanup, fireEvent, render, screen, waitFor } from '@solidjs/testing-library';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { ReviewCard } from './ReviewCard';
+
+const mocks = vi.hoisted(() => ({
+  post: vi.fn().mockResolvedValue({ success: true }),
+  confirm: vi.fn().mockResolvedValue(true),
+  refresh: vi.fn().mockResolvedValue(undefined),
+  toast: vi.fn(),
+}));
+vi.mock('../../services/api', () => ({ api: { post: mocks.post } }));
+vi.mock('../../stores/dashboard', () => ({ useDashboard: () => mocks }));
+
+afterEach(() => { cleanup(); vi.clearAllMocks(); });
+
+const item = {
+  id: 'qq_profile_test', review_source: 'qq_profile', title: 'Beta · 日常语气',
+  status: 'pending', before: '沿用人格', after: '温柔耐心', field_type: 'string',
+  field_options: ['沿用人格', '温柔耐心', '简洁直接'], field_label: '日常语气',
+  evidence: [{ text: '以后直说就好。<script>bad()</script>', timestamp: 1 }],
+};
+
+describe('personal profile review', () => {
+  it('shows a revert action for history without allowing another approval', async () => {
+    render(() => <ReviewCard item={{ ...item, status: 'approved' }} kind="persona" />);
+    expect(screen.queryByLabelText('审批后的值')).toBeNull();
+    expect(screen.queryByRole('button', { name: /通过/ })).toBeNull();
+    await fireEvent.click(screen.getByRole('button', { name: '撤回' }));
+    await waitFor(() => expect(mocks.post).toHaveBeenCalledWith('/api/persona_updates/qq_profile_test/revert', {}));
+  });
+
+  it('shows literal evidence and submits the administrator edited option', async () => {
+    const { container } = render(() => <ReviewCard item={item} kind="persona" />);
+    expect(screen.getByText('以后直说就好。<script>bad()</script>')).toBeInTheDocument();
+    expect(container.querySelector('script')).toBeNull();
+    await fireEvent.change(screen.getByLabelText('审批后的值'), { target: { value: '简洁直接' } });
+    await fireEvent.click(screen.getByRole('button', { name: /通过/ }));
+    await waitFor(() => expect(mocks.post).toHaveBeenCalledWith('/api/persona_updates/qq_profile_test/review', { action: 'approve', modified_content: '简洁直接' }));
+  });
+
+  it('does not send edited values when rejecting a suggestion', async () => {
+    render(() => <ReviewCard item={{ ...item, field_type: 'list', field_options: [], after: 'music' }} kind="persona" />);
+    await fireEvent.input(screen.getByLabelText('审批后的值'), { target: { value: 'new\nvalue' } });
+    await fireEvent.click(screen.getByRole('button', { name: /驳回/ }));
+    await waitFor(() => expect(mocks.post).toHaveBeenCalledWith('/api/persona_updates/qq_profile_test/review', { action: 'reject' }));
+  });
+
+  it('keeps existing persona reviews on their original payload', async () => {
+    render(() => <ReviewCard item={{ id: '12', title: 'Persona', after: 'text' }} kind="persona" />);
+    expect(screen.queryByLabelText('审批后的值')).toBeNull();
+    await fireEvent.click(screen.getByRole('button', { name: /通过/ }));
+    await waitFor(() => expect(mocks.post).toHaveBeenCalledWith('/api/persona_updates/12/review', { action: 'approve' }));
+  });
+});
