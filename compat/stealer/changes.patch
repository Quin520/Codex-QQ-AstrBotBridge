+    def has_other_meme_selection(self, event: AstrMessageEvent) -> bool:
+        """Reserve passive delivery for a meme already selected by Meme Manager.
+
+        Args:
+            event: Current reply event and its trusted plugin-generated extras.
+
+        Returns:
+            Whether Meme Manager selected an image for this turn. Keep a local
+            marker because its after-send hook clears its pending image list.
+        """
+        if event.get_extra("stealer_other_meme_selected"):
+            return True
+        selected = bool(
+            event.get_extra("meme_manager_pending_images")
+            or event.get_extra("meme_manager_semantic_selected_ids")
+            or (
+                event.get_extra("meme_manager_legacy_probability_hit") is True
+                and event.get_extra("found_emotions")
+            )
+        )
+        if selected:
+            event.set_extra("stealer_other_meme_selected", True)
+        return selected
