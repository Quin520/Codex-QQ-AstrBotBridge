+                        "id": row.id,
+                        "group_id": row.group_id,
+                        "user_id": row.user_id,
+                        "before": row.previous_level,
+                        "after": row.proposed_level,
+                        "change": row.proposed_level - row.previous_level,
+                        "reason": row.reason,
+                        "message": row.message,
+                        "mood": row.mood,
+                        "status": effective_status,
+                        "stored_status": row.status,
+                        "current_level": current,
+                        "stale_reason": stale_reason,
