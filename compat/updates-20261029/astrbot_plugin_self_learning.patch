+        self.bridge.config["natural_chat_enabled"] = True
+        self.assert_stable(await self.run_hook(event))
+        self.bridge.config["natural_chat_enabled"] = False
+        self.assertIn("RANDOM_STYLE", await self.run_hook(event))
+        self.assertEqual(self.database.get_recent_bot_responses.await_count, 2)
+
+    async def test_background_json_learning_keeps_its_own_prompt_and_format(self):
+        adapter_type = importlib.import_module(
+            fixture.SELF_MODULE + ".core.framework_llm_adapter"
