+import { readFileSync } from 'node:fs';
+import { fireEvent, waitFor } from '@solidjs/testing-library';
+import { expect, it, vi } from 'vitest';
+
+it('renders shared approvals, refreshes external decisions and protects an edited profile', async () => {
+  const html = readFileSync('../pages/dashboard/index.html', 'utf8');
+  const script = readFileSync('../pages/dashboard/app.js', 'utf8');
+  document.body.innerHTML = html.match(/<body[^>]*>([\s\S]*)<\/body>/i)![1];
+  window.history.replaceState(null, '', '#/reviews');
+  vi.spyOn(window, 'requestAnimationFrame').mockReturnValue(1);
+  vi.spyOn(HTMLCanvasElement.prototype, 'getContext').mockReturnValue(null);
+  let refresh: (() => void) | undefined;
+  const originalInterval = window.setInterval.bind(window);
+  vi.spyOn(window, 'setInterval').mockImplementation(((handler: TimerHandler, timeout?: number) => {
+    if (timeout === 60_000) {
+      refresh = handler as () => void;
+      return 123;
+    }
+    return originalInterval(handler, timeout);
+  }) as typeof window.setInterval);
+  Object.defineProperty(document, 'hidden', { configurable: true, value: false });
+  const rows = [
+    { id: 1, user_id: '123', group_id: '456', before: 0, after: 5, status: 'pending', message: 'A valid interaction' },
+    { id: 2, user_id: '123', group_id: '456', before: 1, after: 3, status: 'stale', stale_reason: 'Base value changed', message: 'Old evidence' },
+  ];
+  const payload = () => ({
+    approval_settings: { require_approval: true, require_affection_approval: false },
+    persona_pending: { updates: [{ id: 'qq_profile_example', title: 'Member setting', review_source: 'qq_profile', before: 'Old setting', after: 'Proposed setting', evidence: [{ text: 'Explicit preference' }] }], total: 1, source_counts: {} },
+    persona_reviewed: { updates: [] }, style_reviews: { reviews: [], total: 0 },
+    jargon_pending: { jargon_list: [], total: 0 }, affection_reviews: { reviews: rows },
+    pending_total: 1 + rows.filter(row => row.status === 'pending').length,
+  });
+  const get = vi.fn(async () => JSON.parse(JSON.stringify(payload())));
+  const post = vi.fn(async (_path: string, body: { id: string; decision: string }) => {
+    rows.find(row => String(row.id) === body.id)!.status = body.decision === 'approve' ? 'approved' : 'rejected';
+    return { success: true, message: 'Saved' };
+  });
+  Object.defineProperty(window, 'AstrBotPluginPage', { configurable: true, value: {
+    ready: async () => ({}), apiGet: get, apiPost: post,
+  } });
+  try {
+    window.eval(script);
+    await waitFor(() => expect(document.getElementById('affection-review-count')).toHaveTextContent('待处理 1 · 失效 1'));
+    expect(document.getElementById('learning-approval-state')).toHaveTextContent('学习内容审批：已开启');
+    expect(document.getElementById('affection-approval-state')).toHaveTextContent('好感度审批：已关闭，新的变化直接生效');
+    expect(document.getElementById('affection-review-history')).toHaveTextContent('Old evidence');
+    expect(document.querySelector('#affection-review-history [data-review-action="approve"]')).toBeNull();
+    expect(post).not.toHaveBeenCalled();
+    fireEvent.click(document.querySelector('[data-kind="affection"][data-review-action="approve"]')!);
+    await waitFor(() => expect(document.getElementById('modal-confirm-ok')).not.toBeNull());
+    expect(post).not.toHaveBeenCalled();
+    fireEvent.click(document.getElementById('modal-confirm-ok')!);
+    await waitFor(() => expect(post).toHaveBeenCalledWith('page/reviews/action', { action: 'affection_review', id: '1', decision: 'approve' }));
+    await waitFor(() => expect(document.getElementById('affection-review-count')).toHaveTextContent('待处理 0 · 失效 1'));
+    rows.push({ id: 3, user_id: '789', group_id: '456', before: 0, after: 2, status: 'pending', message: 'New external suggestion' });
+    refresh!();
+    await waitFor(() => expect(document.getElementById('affection-review-list')).toHaveTextContent('New external suggestion'));
+    rows[2].status = 'rejected';
+    window.dispatchEvent(new Event('focus'));
+    await waitFor(() => expect(document.getElementById('affection-review-count')).toHaveTextContent('待处理 0 · 失效 1'));
+    const editor = document.querySelector('[data-profile-value]') as HTMLTextAreaElement;
+    fireEvent.input(editor, { target: { value: 'Unsaved owner edit' } });
+    const calls = get.mock.calls.length;
+    refresh!();
+    window.dispatchEvent(new Event('focus'));
+    await Promise.resolve();
+    expect(get).toHaveBeenCalledTimes(calls);
+    expect(editor.value).toBe('Unsaved owner edit');
+  } finally {
+    window.dispatchEvent(new Event('pagehide'));
+    vi.restoreAllMocks();
+    document.body.innerHTML = '';
+  }
+});
