@@ -0,0 +1,169 @@
+"""Manual approval of affection changes with atomic application and audit history."""
+
+import hashlib
+import json
+import time
+
+from sqlalchemy import and_, func, select, update
+
+from ...models.orm.affection import AffectionInteraction, AffectionReview, UserAffection
+from ..database.sqlalchemy_database_manager import _AFFECTION_USER_SCOPE
+
+
+class AffectionReviewService:
+    def __init__(self, db_manager, config):
+        self.db = db_manager
+        self.config = config
+
+    def _scope_changed(self, stored_group: str) -> bool:
+        """旧建议不能写入已经停用的好感度存储维度。"""
+        unified = str(getattr(self.config, "affection_scope", "per_group")).lower() == "per_user"
+        return (stored_group == _AFFECTION_USER_SCOPE) != unified
+
+    async def propose(self, group_id: str, user_id: str, previous: int,
+                      proposed: int, interaction_type: str, reason: str,
+                      message: str, mood: str) -> int:
+        """Queue a nonzero change; duplicate callbacks do not multiply it."""
+        if previous == proposed:
+            return 0
+        group_id = self.db._affection_scope_key(group_id)
+        now = time.time()
+        key = hashlib.sha256(json.dumps([
+            group_id, user_id, previous, proposed, interaction_type, message,
+            int(now // 300),
+        ], ensure_ascii=False).encode("utf-8")).hexdigest()
+        async with self.db.get_session() as session:
+            existing = await session.scalar(select(AffectionReview.id).where(
+                AffectionReview.proposal_key == key
+            ))
+            if existing:
+                return existing
+            record = AffectionReview(
+                proposal_key=key, group_id=group_id, user_id=user_id,
+                previous_level=previous, proposed_level=proposed,
+                interaction_type=interaction_type, reason=reason,
+                message=message[:2000], mood=mood, status="pending", created_at=now,
+            )
+            session.add(record)
+            await session.commit()
+            return record.id
+
+    async def list_reviews(self, status: str = "pending") -> list[dict]:
+        """Expose validity without changing stored decisions or evidence.
+
+        Args:
+            status: Effective review status to select, or ``all`` for history.
+
+        Returns:
+            Reviews classified against the current value and per-user limit.
+        """
+        async with self.db.get_session() as session:
+            query = (
+                select(AffectionReview, UserAffection.affection_level)
+                .outerjoin(
+                    UserAffection,
+                    and_(
+                        UserAffection.group_id == AffectionReview.group_id,
+                        UserAffection.user_id == AffectionReview.user_id,
+                    ),
+                )
+                .order_by(AffectionReview.created_at.desc())
+            )
+            if status != "all":
+                query = query.where(
+                    AffectionReview.status == ("pending" if status == "stale" else status)
+                )
+            records = (await session.execute(query)).all()
+            result = []
+            maximum = int(self.config.max_user_affection)
+            for row, current in records:
+                current = current or 0
+                stale_reason = ""
+                if row.status == "pending":
+                    if self._scope_changed(row.group_id):
+                        stale_reason = "好感度存储维度已变化，旧建议不能直接批准。"
+                    elif current != row.previous_level:
+                        stale_reason = f"当前好感度为 {current}，建议依据为 {row.previous_level}；原数值已变化，不能直接批准。"
+                    elif not 0 <= row.proposed_level <= maximum:
