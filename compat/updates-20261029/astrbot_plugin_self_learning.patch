+            with self.subTest(
+                group=event.get_group_id(), platform=event.get_platform_name()
+            ):
+                self.assertIn("RANDOM_STYLE", await self.run_hook(event))
+
+    async def test_missing_inactive_or_lookalike_bridge_cannot_change_style(self):
+        event = self.event(ordinary_type=fixture.AstrMessageEvent)
+        self.star.activated = False
+        self.assertIn("RANDOM_STYLE", await self.run_hook(event))
+        self.star.activated = True
