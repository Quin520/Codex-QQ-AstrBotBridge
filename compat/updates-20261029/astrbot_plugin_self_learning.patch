+            system_prompt="Return only review JSON.",
+            response_format={"type": "json_object"},
+        )
+        self.assertEqual(result, '{"changes":[]}')
+        provider.text_chat.assert_awaited_once_with(
+            prompt="Analyze fictional preference evidence.",
+            contexts=[],
+            system_prompt="Return only review JSON.",
+            response_format={"type": "json_object"},
+        )
+        self.database.get_recent_bot_responses.assert_not_awaited()
+
+
+if __name__ == "__main__":
+    unittest.main()
