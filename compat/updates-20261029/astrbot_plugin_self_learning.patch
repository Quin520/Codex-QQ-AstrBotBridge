+import { createEffect, createSignal, For, Show } from 'solid-js';
+import { api } from '../../services/api';
+import { useDashboard } from '../../stores/dashboard';
+import { list } from '../../pages/shared';
+import { formatTime } from '../../lib/format';
+import { Button, Card, EmptyState, Panel } from '../ui';
+
+type Change = {
+  id: number; group_id: string; user_id: string; before: number; after: number;
+  change: number; reason: string; message: string; status: string; created_at: number;
+  stale_reason?: string; current_level?: number;
+};
+type Status = { require_approval?: boolean; require_affection_approval?: boolean; learning_interval_hours?: number; min_messages?: number; groups?: string[] };
+
+export function LearningApprovalPanel() {
+  const dashboard = useDashboard();
+  const [status, setStatus] = createSignal<Status>({});
+  const [rows, setRows] = createSignal<Change[]>([]);
+  const [group, setGroup] = createSignal('');
+  const [metrics, setMetrics] = createSignal<Record<string, unknown>>({});
+  const [showHistory, setShowHistory] = createSignal(false);
+  const [busy, setBusy] = createSignal(false);
+  let loadToken = 0;
+  const loadMetrics = async (value: string) => {
+    if (value) setMetrics(await api.get(`/api/affection_metrics?${new URLSearchParams({ group_id: value })}`));
+  };
+  const load = async () => {
+    const token = ++loadToken;
+    try {
+      const [state, result] = await Promise.all([
+        api.get<Status>('/api/learning_approval_status'),
+        api.get<{ reviews: Change[] }>('/api/affection_reviews?status=all'),
+      ]);
+      if (token !== loadToken) return;
+      setStatus(state); setRows(result.reviews || []);
+      const selected = group() || state.groups?.[0] || '';
+      setGroup(selected); await loadMetrics(selected);
+    } catch (error) {
+      dashboard.toast(error instanceof Error ? error.message : '学习审批状态加载失败', 'danger');
+    }
+  };
+  createEffect(() => { dashboard.lastUpdated(); void load(); });
+  const decide = async (item: Change, action: 'approve' | 'reject') => {
+    if (!await dashboard.confirm({
+      title: action === 'approve' ? '批准好感度变化' : '驳回好感度建议',
+      message: `${item.user_id}：${item.before} → ${item.after}。${item.reason}`,
+    })) return;
+    setBusy(true);
+    try {
+      await api.post(`/api/affection_reviews/${item.id}/review`, { action });
+      dashboard.toast(action === 'approve' ? '好感度已更新' : '已驳回，数值未变', 'success');
+    } catch (error) {
+      dashboard.toast(error instanceof Error ? error.message : '操作失败', 'danger');
+    } finally { await load(); await dashboard.refresh(true); setBusy(false); }
+  };
+  return <>
+    <Panel title="学习审批状态" actions={<Button onClick={load}>刷新</Button>}>
+      <p>{status().require_approval === undefined ? '学习内容审批：状态暂不可用。' : status().require_approval ? '学习内容审批：已开启，表达、人格、黑话等内容先审批。' : '学习内容审批：未开启强制审批。'}</p>
+      <p>{status().require_affection_approval === undefined ? '好感度审批：状态暂不可用。' : status().require_affection_approval ? '好感度审批：已开启，新的变化须批准后生效。' : '好感度审批：已关闭，新的变化直接生效。已有待审记录保留，不会自动批准或追补。'}</p>
+      <p>两个开关互相独立；可在设置中的“高级设置”和“好感度系统设置”分别调整。</p>
+      <p>批次学习间隔 {status().learning_interval_hours ?? '--'} 小时，至少 {status().min_messages ?? '--'} 条消息。没有新建议也可能是未到阈值或没有足够证据。</p>
+      <p>好感度为 0 的变化不会生成审批；原数值或上限已变化的建议单独显示，不计入待处理。不会仅因时间久而丢弃建议。</p>
+    </Panel>
+    <Panel title={`好感度审批（待处理 ${rows().filter(row => row.status === 'pending').length} · 失效 ${rows().filter(row => row.status === 'stale').length}）`}
+      actions={<Button onClick={() => setShowHistory(!showHistory())}>{showHistory() ? '只看待处理' : '显示处理历史与失效建议'}</Button>}>
+      <For each={rows().filter(row => showHistory() || row.status === 'pending')} fallback={<EmptyState title="暂无好感度建议" />}>
+        {row => <Card>
+          <strong>QQ {row.user_id}：{row.before} → {row.after}（{row.change > 0 ? '+' : ''}{row.change}）</strong>
+          <p>群／会话 {row.group_id} · {formatTime(row.created_at)} · {row.status}</p>
+          <p>{row.reason}</p><blockquote>{row.message}</blockquote>
+          <Show when={row.stale_reason}><p>{row.stale_reason}</p></Show>
+          <Show when={row.status === 'pending'}><div class="inline-actions">
+            <Button disabled={busy()} tone="success" onClick={() => decide(row, 'approve')}>通过</Button>
+            <Button disabled={busy()} tone="warning" onClick={() => decide(row, 'reject')}>驳回</Button>
+          </div></Show>
+        </Card>}
+      </For>
+    </Panel>
+    <Panel title="当前好感度与实际变化记录">
+      <label>群／会话 <select value={group()} onChange={event => {
+        const selected = event.currentTarget.value; setGroup(selected);
+        void loadMetrics(selected).catch(error => dashboard.toast(String(error), 'danger'));
+      }}><For each={status().groups || []}>{id => <option value={id}>{id}</option>}</For></select></label>
+      <p><For each={list<Record<string, unknown>>(metrics().users)}>{row => <span>QQ {String(row.user_id)}：{String(row.affection_level)}　</span>}</For></p>
+      <For each={list<Record<string, unknown>>(metrics().history)} fallback={<EmptyState title="暂无变化明细（旧版本未记录的明细无法补造）" />}>
+        {row => <p>{formatTime(row.timestamp)} · QQ {String(row.user_id)}：{String(row.previous_level)} → {String(row.new_level)} · {String(row.reason || '')}</p>}
+      </For>
+    </Panel>
+  </>;
+}
