+def test_remote_panel_requires_trusted_origin_and_bearer_token(tmp_path):
+    async def run():
+        service = JournalService(
+            {"group_id": "100001", "auto_summary": False},
+            Store(tmp_path),
+            FakeEngine(),
+            summary,
+            members,
+        )
+        panel = WebPanel(service, tmp_path, 7844)
+        origin = "http://100.108.224.26:7844"
+        headers = {"Host": "100.108.224.26:7844", "Origin": origin}
+        async with TestClient(TestServer(panel.app)) as client:
+            assert (await client.get("/api/status", headers=headers)).status == 403
+            service.config["web_trusted_origins"] = [origin]
+            assert (await client.get("/api/status", headers=headers)).status == 401
+            headers["Authorization"] = "Bearer " + panel.token
+            assert (await client.get("/api/status", headers=headers)).status == 200
+            for override in (
+                {"Origin": "https://untrusted.invalid"},
+                {"Host": "rebind.invalid:7844"},
+                {"Host": "100.108.224.26:9999"},
+                {"Authorization": "Bearer wrong-token"},
+            ):
+                response = await client.get("/api/status", headers={**headers, **override})
+                assert response.status in {401, 403}
+        await service.close()
+
+    asyncio.run(run())
