+"""Exercise scheduled delivery without connecting to QQ."""
+
+import importlib
+import os
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+from unittest.mock import AsyncMock
+
+_runtime = tempfile.TemporaryDirectory(prefix="pokepro-test-")
+os.environ["ASTRBOT_ROOT"] = _runtime.name
+_package = ModuleType("audited_pokepro")
+_package.__path__ = [str(Path(__file__).resolve().parents[1])]
+sys.modules[_package.__name__] = _package
+PokeScheduler = importlib.import_module("audited_pokepro.core.scheduler").PokeScheduler
+PokeSender = importlib.import_module("audited_pokepro.core.send_poke").PokeSender
+
+
+class SchedulerTests(unittest.IsolatedAsyncioTestCase):
+    async def test_one_target_is_delivered_as_one_whole_identifier(self):
+        config = SimpleNamespace(
+            scheduler=SimpleNamespace(cron="30 22 * * *", times=1),
+            target_list=[("456", "123456")],
+            poke_interval=0,
+        )
+        client = SimpleNamespace(group_poke=AsyncMock(), friend_poke=AsyncMock())
+        scheduler = PokeScheduler(config, PokeSender(config))
+        scheduler.set_client(client)
+        await scheduler._on_trigger()
+        client.group_poke.assert_awaited_once_with(group_id=456, user_id=123456)
+        client.friend_poke.assert_not_awaited()
+
+    async def test_multiple_targets_and_repetitions_remain_separate(self):
+        config = SimpleNamespace(
+            scheduler=SimpleNamespace(cron="30 22 * * *", times=2),
+            target_list=[("456", "123456"), ("789", "234567")],
+            poke_interval=0,
+        )
+        client = SimpleNamespace(group_poke=AsyncMock(), friend_poke=AsyncMock())
+        scheduler = PokeScheduler(config, PokeSender(config))
+        scheduler.set_client(client)
+        await scheduler._on_trigger()
+        self.assertEqual(
+            [call.kwargs for call in client.group_poke.await_args_list],
+            [{"group_id": 456, "user_id": 123456}] * 2
+            + [{"group_id": 789, "user_id": 234567}] * 2,
+        )
+
+    async def test_no_registered_client_does_not_send(self):
+        config = SimpleNamespace(
+            scheduler=SimpleNamespace(cron="30 22 * * *", times=1),
+            target_list=[("456", "123456")],
+        )
+        sender = SimpleNamespace(client_send=AsyncMock())
+        scheduler = PokeScheduler(config, sender)
+        await scheduler._on_trigger()
+        sender.client_send.assert_not_awaited()
+
+
+if __name__ == "__main__":
+    unittest.main()
