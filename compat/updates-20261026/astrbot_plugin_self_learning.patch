+from functools import wraps
+from ipaddress import ip_address
 
 persona_reviews_bp = Blueprint('persona_reviews', __name__, url_prefix='/api')
 
 
+def require_review_access(handler):
+    """Keep member evidence and approval local when WebUI has no password."""
+    @wraps(handler)
+    @require_auth
+    async def guarded(*args, **kwargs):
+        if not is_webui_password_enabled(get_container().plugin_config):
+            try:
+                address = ip_address(request.remote_addr or "")
+                local = address.is_loopback or bool(
+                    getattr(address, 'ipv4_mapped', None)
+                    and address.ipv4_mapped.is_loopback
+                )
+            except ValueError:
+                local = False
+            if not local:
+                return jsonify({"error": "免密模式下，审批页面仅允许本机访问；远程使用请先启用管理页密码。"}), 403
+        return await handler(*args, **kwargs)
+    return guarded
+
+
+@persona_reviews_bp.route("/affection_reviews", methods=["GET"])
+@require_review_access
+async def affection_reviews():
+    from ...services.learning.affection_review import AffectionReviewService
+
+    container = get_container()
+    status = request.args.get("status", "pending")
+    if status not in {"all", "pending", "approved", "rejected"}:
+        return jsonify({"error": "Invalid status"}), 400
+    rows = await AffectionReviewService(
+        container.database_manager, container.plugin_config
+    ).list_reviews(status)
+    return jsonify({"success": True, "reviews": rows, "total": len(rows)})
+
+
+@persona_reviews_bp.route("/affection_reviews/<int:review_id>/review", methods=["POST"])
+@require_review_access
+async def review_affection(review_id: int):
+    from ...services.learning.affection_review import AffectionReviewService
+
+    container = get_container()
+    data = await request.get_json() or {}
+    if data.get("action") not in {"approve", "reject"}:
+        return jsonify({"error": "Invalid action"}), 400
+    success, message = await AffectionReviewService(
+        container.database_manager, container.plugin_config
+    ).decide(review_id, data["action"])
+    return jsonify({"success": success, "message": message, **({} if success else {"error": message})}), 200 if success else 409
+
+
