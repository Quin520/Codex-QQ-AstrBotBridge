+"""Recover legacy unreviewed outputs into the owner's review queue once."""
+
+import json
+import time
+
+from sqlalchemy import select, update
+
+from ...models.orm.affection import ApprovalMigration
+from ...models.orm.expression import ExpressionGenerationResult, ExpressionPattern
+from ...models.orm.jargon import Jargon
+from ...models.orm.learning import LearningBatch, StyleLearningReview
+from .expression_review import pattern_key, queue_patterns_in_session
+
+
+async def prepare_approval_baseline(db) -> None:
+    """Quarantine unapproved examples, preserving accepted and rejected decisions."""
+    if not getattr(db.config, "require_learning_approval", False):
+        return
+    async with db.get_session() as session:
+        if await session.get(ApprovalMigration, "manual-learning-v1"):
+            return
+        approved = set()
+        for review in await session.scalars(select(StyleLearningReview).where(
+            StyleLearningReview.status == "approved"
+        )):
+            for pattern in json.loads(review.learned_patterns or "[]"):
+                if isinstance(pattern, dict):
+                    approved.add((review.group_id, *pattern_key(pattern)))
+        groups = {}
+        for pattern in await session.scalars(select(ExpressionPattern)):
+            if (pattern.group_id, pattern.persona_id, pattern.user_id,
+                    pattern.situation, pattern.expression) in approved:
+                continue
+            # Keep referenced generation history intact rather than silently dropping it.
+            linked = await session.scalar(select(ExpressionGenerationResult.id).where(
+                ExpressionGenerationResult.pattern_id == pattern.id
+            ).limit(1))
+            if linked:
+                raise RuntimeError("Legacy examples have generation history; manual migration required")
+            groups.setdefault(pattern.group_id, []).append(pattern.to_dict())
+            await session.delete(pattern)
+        await session.flush()
+        for group_id, patterns in groups.items():
+            await queue_patterns_in_session(
+                session, group_id, patterns, "default", "历史未审核样例",
+                include_active=True,
+            )
+        await session.execute(update(Jargon).where(
+            Jargon.is_jargon.is_(True), Jargon.is_complete.is_not(True)
+        ).values(is_jargon=False))
+        await session.execute(update(LearningBatch).where(
+            LearningBatch.status == "pending", LearningBatch.end_time.is_not(None),
+            LearningBatch.success.is_(True),
+        ).values(status="completed"))
+        session.add(ApprovalMigration(name="manual-learning-v1", completed_at=time.time()))
+        await session.commit()
