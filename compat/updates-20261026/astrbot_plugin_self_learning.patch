+        async with self.db.get_session() as session:
+            record = await session.get(AffectionReview, review_id)
+            if record is None or record.status != "pending":
+                return False, "建议不存在或已经处理"
+            status = "approved" if action == "approve" else "rejected"
+            claimed = await session.execute(update(AffectionReview).where(
+                AffectionReview.id == review_id, AffectionReview.status == "pending"
+            ).values(status=status, reviewed_at=time.time()))
+            if claimed.rowcount != 1:
+                await session.rollback()
+                return False, "建议已被其他操作处理，请刷新"
+            if action == "reject":
+                await session.commit()
+                return True, "已驳回，好感度未改变"
+            owner = await session.scalar(select(UserAffection).where(
+                UserAffection.group_id == record.group_id,
+                UserAffection.user_id == record.user_id,
+            ))
+            previous = owner.affection_level if owner else 0
+            maximum = int(self.config.max_user_affection)
+            if previous != record.previous_level or not 0 <= record.proposed_level <= maximum:
+                await session.rollback()
+                return False, "当前数值或上限已变化，请驳回过期建议，等待新的互动建议"
+            total = await session.scalar(select(func.sum(UserAffection.affection_level)).where(
+                UserAffection.group_id == record.group_id
+            )) or 0
+            delta = record.proposed_level - previous
+            if delta > 0 and total + delta > int(self.config.max_total_affection):
+                await session.rollback()
+                return False, "超过群好感度总上限；不会自动扣减其他成员，请调整上限或驳回"
+            now = int(time.time())
+            if owner is None:
+                owner = UserAffection(
+                    group_id=record.group_id, user_id=record.user_id,
+                    created_at=now, max_affection=maximum,
+                )
+                session.add(owner)
+            owner.affection_level = record.proposed_level
+            owner.updated_at = now
+            await session.flush()
+            session.add(AffectionInteraction(
+                user_affection_id=owner.id, interaction_type=record.interaction_type,
+                affection_delta=delta, timestamp=now,
+                message_content=json.dumps({
+                    "message": record.message, "reason": record.reason,
+                    "mood": record.mood, "previous_level": previous,
+                    "new_level": record.proposed_level, "review_id": record.id,
+                }, ensure_ascii=False),
+            ))
+            await session.commit()
+            return True, "已批准并保存好感度变化"
