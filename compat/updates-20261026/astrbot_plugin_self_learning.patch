+                "id": row.id, "group_id": row.group_id, "user_id": row.user_id,
+                "before": row.previous_level, "after": row.proposed_level,
+                "change": row.proposed_level - row.previous_level,
+                "reason": row.reason, "message": row.message, "mood": row.mood,
+                "status": row.status, "created_at": row.created_at,
+                "reviewed_at": row.reviewed_at,
+            } for row in records]
+
+    async def decide(self, review_id: int, action: str) -> tuple[bool, str]:
+        """Apply exactly the reviewed value; reject stale snapshots and double clicks."""
+        if action not in {"approve", "reject"}:
