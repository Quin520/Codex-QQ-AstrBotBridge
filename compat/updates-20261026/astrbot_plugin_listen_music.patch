+def parse_bilibili_short_url(value: str) -> str | None:
+    """Return a validated short link, dropping tracking parameters.
+
+    Args:
+        value: User-supplied text containing an optional short link.
+
+    Returns:
+        An HTTPS b23.tv URL, or None when no short link exists.
+
+    Raises:
+        ValueError: If an embedded URL is not an approved reference.
+    """
+    urls = [
+        _validate_reference_url(url.rstrip("。，,!?！?）)"))
+        for url in _REFERENCE_URL_RE.findall(value)
+    ]
+    for parsed in urls:
+        if parsed.hostname == "b23.tv":
