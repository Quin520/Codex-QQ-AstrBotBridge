+def _source_failure_message(exc: Exception, operation: str) -> str:
+    """Describe upstream failures without leaking request URLs or credentials.
+
+    Args:
+        exc: Underlying request failure.
+        operation: Short operation label for the user.
+
+    Returns:
+        A retryable source error, distinct from an empty song catalogue.
+    """
+    if isinstance(exc, BilibiliHttpError):
+        if exc.status in {403, 412, 429}:
+            return f"Bilibili {operation}暂时受限（HTTP {exc.status}），请稍后重试；这不代表没有音源"
+        return f"Bilibili {operation}失败（HTTP {exc.status}），请稍后重试"
+    if isinstance(exc, BilibiliApiError):
+        return f"Bilibili {operation}暂时不可用（接口代码 {exc.code}），请稍后重试"
+    return f"Bilibili {operation}暂时不可用，请稍后重试"
