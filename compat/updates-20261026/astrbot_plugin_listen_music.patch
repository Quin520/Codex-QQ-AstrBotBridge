+def _validate_reference_url(value: str) -> SplitResult:
+    """Validate a reference before any network request or identifier extraction.
+
+    Args:
+        value: Complete URL from user input or a short-link Location header.
+
+    Returns:
+        Parsed URL restricted to approved hosts and video/reference paths.
+
+    Raises:
+        ValueError: If the URL is not an approved public Bilibili reference.
+    """
+    try:
+        parsed = urlsplit(value)
+        if (
+            parsed.scheme not in {"http", "https"}
+            or parsed.hostname not in _REFERENCE_HOSTS
+            or parsed.username is not None
+            or parsed.password is not None
+            or parsed.port is not None
+            or "\\" in value
+            or any(ord(char) < 32 for char in value)
+        ):
+            raise ValueError
+        pattern = (
+            r"/[A-Za-z0-9]{1,32}/?"
+            if parsed.hostname == "b23.tv"
+            else r"/video/(?:BV[0-9A-Za-z]{10}|av[1-9][0-9]{0,18})/?"
+        )
+        if re.fullmatch(pattern, parsed.path, re.IGNORECASE) is None:
+            raise ValueError
+    except ValueError as exc:
+        raise ValueError(
+            "仅支持合法的 Bilibili 视频链接或 b23.tv 短链接（不支持端口或账号信息）"
+        ) from exc
+    return parsed
