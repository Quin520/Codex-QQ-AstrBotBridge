+def extract_json_preview(data: dict | str, matched_link: str) -> str | None:
+    """Read the supplied card preview only when it belongs to the matched link.
+
+    Args:
+        data: The platform-supplied JSON card, not a fetched webpage.
+        matched_link: The exact URL fragment selected by the parser handler.
+
+    Returns:
+        A bounded title/description preview, or None for an unrelated/empty card.
+    """
+    if isinstance(data, str):
+        try:
+            data = json.loads(data)
+        except (ValueError, TypeError):
+            return None
+    if not isinstance(data, dict) or not matched_link:
+        return None
+    meta = data.get("meta")
+    if not isinstance(meta, dict):
+        return None
+    for key in ("news", "detail_1"):
+        node = meta.get(key)
+        if not isinstance(node, dict):
+            continue
+        url = extract_json_url({"meta": {key: node}})
+        if not url or matched_link not in url:
+            continue
+        parts = []
+        for field in ("title", "desc"):
+            value = node.get(field)
+            if isinstance(value, str) and value.strip() and value.strip() not in parts:
+                parts.append(value.strip())
+        return "\n".join(parts)[:1200] or None
+    return None
 
 
