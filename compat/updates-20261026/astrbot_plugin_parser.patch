+"""Exercise real parser handling and shared context with fictional cards and fake sends."""
+
+import importlib
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+from types import ModuleType, SimpleNamespace
+import unittest
+from unittest.mock import AsyncMock, Mock
+
+PLUGIN = Path(__file__).resolve().parents[1]
+package = ModuleType("parser_verification_test")
+package.__path__ = [str(PLUGIN)]
+sys.modules[package.__name__] = package
+main_module = importlib.import_module("parser_verification_test.main")
+data_module = importlib.import_module("parser_verification_test.core.data")
+error_module = importlib.import_module("parser_verification_test.core.exception")
+sender_module = importlib.import_module("parser_verification_test.core.sender")
+utils = importlib.import_module("parser_verification_test.core.utils")
+xiaoheihe = importlib.import_module("parser_verification_test.core.parsers.xiaoheihe")
+bridge = ModuleType("bridge_verification_test")
+bridge.__path__ = [
+    os.environ.get(
+        "CODEX_BRIDGE_PLUGIN_DIR", str(PLUGIN.parent / "astrbot_plugin_local_codex")
+    )
+]
+sys.modules[bridge.__name__] = bridge
+GroupContext = importlib.import_module(
+    "bridge_verification_test.group_context"
+).GroupContext
+
+from astrbot.core.message.components import Json, Plain
+from astrbot.core.platform.message_type import MessageType
+from astrbot.core.platform.sources.aiocqhttp.aiocqhttp_message_event import (
+    AiocqhttpMessageEvent,
+)
+
+URL = "https://api.xiaoheihe.cn/v3/bbs/app/api/web/share?link_id=111&h_src=fictional"
+CANONICAL = "https://www.xiaoheihe.cn/app/bbs/link/111"
+
+
+def card():
+    return {
+        "app": "com.tencent.tuwen.lua",
+        "meta": {
+            "news": {
+                "jumpUrl": URL,
+                "title": "纸船实验",
+                "desc": "蓝色纸船漂了十米",
+                "tag": "小黑盒",
+            }
+        },
+    }
+
+
+class VerificationPreviewTests(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.memory = GroupContext(
+            {"owner_qq": "123", "group_qq": "456", "group_context_enabled": True},
+            Path(self.temp.name) / "context.json",
+        )
+        context = SimpleNamespace(
+            get_registered_star=Mock(
+                return_value=SimpleNamespace(
+                    activated=True,
+                    star_cls=SimpleNamespace(
+                        observe_parsed_link=self.memory.observe_parsed_link
+                    ),
+                )
+            )
+        )
+        self.cfg = SimpleNamespace(
+            whitelist=[],
+            blacklist=[],
+            require_at_in_group=True,
+            enable_reply_parse=False,
+            single_heavy_render_card=False,
+            forward_threshold=2,
+            context=context,
+        )
+        self.parser = SimpleNamespace(
+            parse=AsyncMock(
+                side_effect=error_module.VerificationRequiredException(
+                    "小黑盒要求验证码，暂时无法获取正文。", CANONICAL
+                )
+            ),
+            result=xiaoheihe.XiaoheiheParser.result,
+        )
+        self.plugin = main_module.ParserPlugin.__new__(main_module.ParserPlugin)
+        self.plugin.cfg = self.cfg
+        self.plugin.key_pattern_list = xiaoheihe.XiaoheiheParser._key_patterns
+        self.plugin.parser_map = {
+            key: self.parser for key, _ in self.plugin.key_pattern_list
+        }
+        self.plugin.arbiter = SimpleNamespace(compete=AsyncMock(return_value=True))
+        self.plugin.debouncer = SimpleNamespace(
+            hit_link=Mock(return_value=False), hit_resource=Mock(return_value=False)
+        )
+        self.plugin.sender = sender_module.MessageSender(self.cfg, Mock())
+        self.event = Mock(spec=AiocqhttpMessageEvent)
+        self.event.bot = Mock()
+        self.event.unified_msg_origin = "test:GroupMessage:123_456"
+        self.event.message_str = ""
+        self.event.message_obj = SimpleNamespace(
+            message_id="7", raw_message={"message_id": 7, "self_id": 999, "time": 1}
+        )
+        self.event.get_messages.return_value = [
+            Json(data=json.dumps(card(), ensure_ascii=False))
+        ]
+        self.event.get_self_id.return_value = "999"
+        self.event.get_sender_id.return_value = "123"
+        self.event.get_sender_name.return_value = "Alpha"
+        self.event.get_group_id.return_value = "456"
+        self.event.get_platform_id.return_value = "test"
+        self.event.get_platform_name.return_value = "aiocqhttp"
+        self.event.get_message_type.return_value = MessageType.GROUP_MESSAGE
+        self.event.is_private_chat.return_value = False
+        self.event.chain_result.side_effect = lambda chain: SimpleNamespace(chain=chain)
+        self.event.send = AsyncMock()
+        extras = {}
+        self.event.get_extra.side_effect = lambda key, default=None: extras.get(
+            key, default
+        )
+        self.event.set_extra.side_effect = extras.__setitem__
+
+    async def test_challenge_card_is_sent_as_limited_preview_and_remembered(self):
+        await self.plugin.on_message(self.event)
+        self.event.send.assert_awaited_once()
+        sent = self.event.send.call_args.args[0].chain[0].text
+        self.assertIn("未取得全文", sent)
+        self.assertIn("纸船实验", sent)
+        self.assertIn("蓝色纸船漂了十米", sent)
+        self.assertEqual(len(self.memory.rows), 1)
+        self.assertEqual(self.memory.rows[0]["qq"], "123")
+        self.assertEqual(self.memory.rows[0]["source_url"], CANONICAL)
+        self.assertIn("未取得全文", self.memory.rows[0]["text"])
+
+    async def test_failed_send_never_claims_a_delivered_preview(self):
+        self.event.send.side_effect = RuntimeError("fictional delivery failure")
+        await self.plugin.on_message(self.event)
+        self.assertEqual(self.memory.rows, [])
+
+    async def test_plain_link_reports_challenge_without_inventing_content(self):
+        self.event.get_messages.return_value = [Plain(URL)]
+        self.event.message_str = URL
+        await self.plugin.on_message(self.event)
+        self.event.send.assert_awaited_once()
+        self.assertIn("验证码", self.event.send.call_args.args[0].chain[0].text)
+        self.assertEqual(self.memory.rows, [])
+
+    async def test_other_parse_errors_are_not_relabelled_as_card_success(self):
+        self.parser.parse.side_effect = error_module.ParseException("post removed")
+        with self.assertRaisesRegex(error_module.ParseException, "post removed"):
+            await self.plugin.on_message(self.event)
+        self.event.send.assert_not_awaited()
+        self.assertEqual(self.memory.rows, [])
+
+    async def test_successful_fetch_keeps_actual_body_instead_of_card_preview(self):
+        self.parser.parse.side_effect = None
+        self.parser.parse.return_value = self.parser.result(
+            title="原文标题", text="完整正文", url=CANONICAL
+        )
+        await self.plugin.on_message(self.event)
+        self.assertIn("完整正文", self.memory.rows[0]["text"])
+        self.assertNotIn("未取得全文", self.memory.rows[0]["text"])
+
+    async def test_site_response_is_typed_and_other_errors_remain_errors(self):
+        parser = xiaoheihe.XiaoheiheParser.__new__(xiaoheihe.XiaoheiheParser)
+        parser.headers = {}
+        parser._request_json = AsyncMock(return_value={"status": "show_captcha"})
+        with self.assertRaises(error_module.VerificationRequiredException) as caught:
+            await parser._fetch_link_tree("111", {"x_xhh_tokenid": "fictional"})
+        self.assertEqual(caught.exception.source_url, CANONICAL)
+        parser._request_json.return_value = {"status": "not_found"}
+        with self.assertRaisesRegex(error_module.ParseException, "not_found"):
+            await parser._fetch_link_tree("111", {"x_xhh_tokenid": "fictional"})
+
+    async def test_disabled_scope_does_not_add_card_to_other_group(self):
+        self.event.get_group_id.return_value = "888"
+        await self.plugin.on_message(self.event)
+        self.assertEqual(self.memory.rows, [])
+
+    def test_preview_is_bounded_and_does_not_borrow_other_cards(self):
+        original = card()
+        self.assertIsNone(utils.extract_json_preview(original, "link_id=222"))
+        self.assertIsNone(utils.extract_json_preview("broken json", "link_id=111"))
