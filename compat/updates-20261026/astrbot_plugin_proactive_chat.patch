+    async def start(self):
+        await self.plugin._setup_auto_triggers_for_enabled_sessions()
+
+    async def fire_now(self):
+        """Let APScheduler dispatch its actual registered callback."""
+        p = self.plugin
+        job = p.scheduler.get_job(KEY)
+        self.assertIsNotNone(job)
+        completed = asyncio.get_running_loop().create_future()
+
+        def on_finished(event):
+            if event.job_id == KEY and not completed.done():
+                completed.set_result(event)
+
+        p.scheduler.add_listener(on_finished, EVENT_JOB_EXECUTED | EVENT_JOB_ERROR)
+        try:
+            p.scheduler.modify_job(KEY, next_run_time=datetime.now(p.timezone))
+            p.scheduler.resume()
+            result = await asyncio.wait_for(completed, 2)
+            self.assertIsNone(result.exception)
+        finally:
+            p.scheduler.remove_listener(on_finished)
+
+    async def test_startup_direct_interval_and_concurrent_activity_preserve_deadline(self):
+        p = self.plugin
+        await self.start()
+        deadline = p.scheduler.get_job(KEY).next_run_time
+        self.draw.assert_called_once_with(2700, 3600)
+        p.session_data[KEY]["unanswered_count"] = 1
+        await asyncio.gather(*[p.on_group_message(fixtures.event(str(i))) for i in range(10)])
+        await p.on_after_message_sent(fixtures.event("123"))
+        await p._setup_auto_trigger(KEY)
+        await p._reset_group_silence_timer(KEY)
+        self.assertEqual(p.scheduler.get_job(KEY).next_run_time, deadline)
+        self.assertEqual(len(p.scheduler.get_jobs()), 1)
+        self.assertEqual(p.session_data[KEY]["unanswered_count"], 0)
+        self.assertEqual(p.group_timers, {})
+        self.assertEqual(p.auto_trigger_timers, {})
+        self.assertEqual(self.draw.call_count, 1)
+        self.assertGreater(p.last_message_times[KEY], 0)
+
+    async def test_real_due_job_delivers_during_continuous_activity_and_reschedules(self):
+        p = self.plugin
+        self.draw.side_effect = [0.08, 3000]
+        await self.start()
+        deadline = p.scheduler.get_job(KEY).next_run_time
+        p.scheduler.resume()
+        for _ in range(35):
+            await p.on_group_message(fixtures.event("123"))
+            # APScheduler removes a one-shot job when dispatching it, before
+            # its async callback sends the message and registers the next job.
+            if not self.deliveries and datetime.now(p.timezone) < deadline:
+                self.assertEqual(p.scheduler.get_job(KEY).next_run_time, deadline)
+            await asyncio.sleep(0.005)
+        self.assertEqual(len(self.deliveries), 1)
+        self.assertEqual(p._generate_llm_response.await_count, 1)
+        self.assertEqual(len(p.scheduler.get_jobs()), 1)
+        self.assertGreater(p.session_data[KEY]["next_trigger_time"], deadline.timestamp())
+        self.assertEqual(p.session_data[KEY]["schedule_trigger_mode"], "interval")
+        self.assertFalse(p.group_timers or p.auto_trigger_timers)
+
+    async def test_quiet_group_delivers_then_pauses_at_two_unanswered(self):
+        p = self.plugin
+        await self.start()
+        await self.fire_now()
+        self.assertEqual(len(self.deliveries), 1)
+        self.assertEqual(p.session_data[KEY]["unanswered_count"], 1)
+        await self.fire_now()
+        self.assertEqual(len(self.deliveries), 2)
+        self.assertEqual(p.session_data[KEY]["unanswered_count"], 2)
+        self.assertIsNone(p.scheduler.get_job(KEY))
+        self.assertNotIn("next_trigger_time", p.session_data[KEY])
+        await p.on_after_message_sent(fixtures.event("123"))
+        self.assertEqual(p.session_data[KEY]["unanswered_count"], 2)
+        self.assertIsNone(p.scheduler.get_job(KEY))
+        await p.on_group_message(fixtures.event("999"))
+        self.assertEqual(p.session_data[KEY]["unanswered_count"], 0)
+        self.assertIsNotNone(p.scheduler.get_job(KEY))
+
+    async def test_quiet_hours_skip_generation_and_retry_full_interval(self):
+        p = self.plugin
+        await self.start()
+        p.scheduler.remove_job(KEY)
+        with patch.object(flow, "is_quiet_time", return_value=True):
+            await p.check_and_chat(KEY)
+        self.assertEqual(self.deliveries, [])
+        p._generate_llm_response.assert_not_awaited()
+        self.assertIsNotNone(p.scheduler.get_job(KEY))
+        self.assertEqual(self.draw.call_count, 2)
+
+    async def test_restore_keeps_deadline_and_mode_change_replaces_old_schedule(self):
+        p = self.plugin
+        await self.start()
+        snapshot = deepcopy(p.session_data)
+        deadline = p.scheduler.get_job(KEY).next_run_time
+        p.scheduler.remove_all_jobs()
+        p.session_data = snapshot
+        await p._init_jobs_from_data()
+        await self.start()
+        self.assertEqual(p.scheduler.get_job(KEY).next_run_time, deadline)
+        self.assertEqual(self.draw.call_count, 1)
+        p.scheduler.remove_all_jobs()
+        p.session_data[KEY]["schedule_trigger_mode"] = "idle"
+        p.session_data[KEY]["next_trigger_time"] = time.time() + 6 * 3600
+        await p._init_jobs_from_data()
+        await self.start()
+        self.assertLess(p.session_data[KEY]["next_trigger_time"], time.time() + 3601)
+        self.assertEqual(self.draw.call_count, 2)
+
+    async def test_mode_change_cancels_idle_timers_and_interval_change_reseeds(self):
+        p = self.plugin
+        p.config["group_settings"]["trigger_mode"] = "idle"
+        await p._setup_auto_trigger(KEY)
+        await p._reset_group_silence_timer(KEY)
+        handles = [*p.auto_trigger_timers.values(), *p.group_timers.values()]
+        await p._schedule_next_chat_and_save(KEY)
+        p.config["group_settings"]["trigger_mode"] = "interval"
+        await self.start()
+        self.assertTrue(all(handle.cancelled() for handle in handles))
