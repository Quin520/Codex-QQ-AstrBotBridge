+class HistoryScopeTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.engine = create_async_engine("sqlite+aiosqlite:///:memory:")
+        async with self.engine.begin() as conn:
+            await conn.run_sync(PlatformMessageHistory.__table__.create)
+        self.sessions = async_sessionmaker(self.engine, expire_on_commit=False)
+        self.plugin = Harness(platform_id="test_%")
+        self.plugin.context.message_history_manager = SimpleNamespace(
+            db=SimpleNamespace(get_db=self.sessions), get=AsyncMock(return_value=[])
+        )
+        scopes = [
+            ("test_%", "test_%:GroupMessage:456"),
+            ("test_%", "test_%:GroupMessage:123_456"),
+            ("test_%", "test_%:GroupMessage:999_456"),
+            ("test_%", "test_%:GroupMessage:123_4567"),
+            ("test_%", "test_%:GroupMessage:123_1456"),
+            ("test_%", "test_%:FriendMessage:123_456"),
+            ("other", "test_%:GroupMessage:123_456"),
+            ("test_%", "testABC:GroupMessage:123_456"),
+            ("test_%", "456"),
+        ]
+        async with self.sessions() as session:
+            for index, (platform, scope) in enumerate(scopes):
+                session.add(
+                    PlatformMessageHistory(
+                        platform_id=platform,
+                        user_id=scope,
+                        sender_id="123",
+                        content={"message": [{"type": "text", "text": f"row-{index}"}]},
+                    )
+                )
+            await session.commit()
+
+    async def asyncTearDown(self):
+        await self.engine.dispose()
+
+    async def test_group_history_merges_members_without_cross_scope_reads(self):
+        records, count = await self.plugin._load_platform_message_history_records(
+            "test_%:GroupMessage:456", 20
+        )
+        self.assertEqual(count, 3)
+        self.assertEqual([record.id for record in records], [1, 2, 3])
+        records, count = await self.plugin._load_platform_message_history_records(
+            "test_%:GroupMessage:456", 2
+        )
+        self.assertEqual(count, 2)
+        self.assertEqual([record.id for record in records], [2, 3])
+
+    async def test_other_platform_does_not_apply_qq_member_pattern(self):
+        other = Harness(platform_id="test_%", platform_name="telegram")
+        other.context.message_history_manager = (
+            self.plugin.context.message_history_manager
+        )
+        records, count = await other._load_platform_message_history_records(
+            "test_%:GroupMessage:456", 20
+        )
+        self.assertEqual(count, 1)
+        self.assertEqual(records[0].id, 1)
+
