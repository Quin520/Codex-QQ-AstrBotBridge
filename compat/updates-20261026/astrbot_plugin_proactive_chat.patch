+"""Exercise interval scheduling with real timers and an isolated fake sender."""
+
+from __future__ import annotations
+
+import asyncio
+import importlib
+import time
+import unittest
+from copy import deepcopy
+from datetime import datetime
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+from apscheduler.events import EVENT_JOB_ERROR, EVENT_JOB_EXECUTED
+
+import test_bridge_sessions as fixtures
+import test_proactive_llm as llm_fixtures
+
+flow = llm_fixtures.flow_module
+scheduler = importlib.import_module("proactive_test.core.task_scheduler")
+KEY = "test:GroupMessage:456"
+
+
+class IntervalHarness(fixtures.Harness, flow.ProactiveCoreMixin):
+    check_and_chat = flow.ProactiveCoreMixin.check_and_chat
+
+
+class IntervalSchedulingTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        await fixtures.GroupSchedulingTests.asyncSetUp(self)
+        p = self.plugin
+        p.__class__ = IntervalHarness
+        p.config["group_settings"].update(
+            trigger_mode="interval",
+            schedule_settings={
+                "min_interval_minutes": 45,
+                "max_interval_minutes": 60,
+                "quiet_hours": "",
+                "max_unanswered_times": 2,
+            },
+        )
+        p._active_chat_sessions = set()
+        p._active_chat_tasks = {}
+        p.manual_trigger_sessions = set()
+        p.context.conversation_manager = SimpleNamespace(add_message_pair=AsyncMock())
+        p._verify_message_persisted = AsyncMock(return_value=True)
+        p._prepare_llm_request = AsyncMock(return_value={
+            "conv_id": "fixture", "history": [], "system_prompt": "persona",
+        })
+        p._build_proactive_event = lambda sid: SimpleNamespace(
+            get_extra=lambda key, default=None: default,
+        )
+        p._generate_llm_response = AsyncMock(return_value=("A short reply.", "task"))
+        p._extract_response_text = lambda response: response
+        p._extract_response_chain = lambda response: []
+        self.deliveries = []
+
+        async def fake_send(sid, text, **kwargs):
+            self.deliveries.append((sid, text))
+            await p.on_after_message_sent(fixtures.event("123"))
+            return True
+
+        p._send_proactive_message = AsyncMock(side_effect=fake_send)
+        self.random = patch.object(fixtures.load("task_scheduler").random, "randint", return_value=3000)
+        self.draw = self.random.start()
