+                )
+            ]
+        )
+        self.session_data = {}
+        self.telemetry = None
+        self.data_dir = RUNTIME.name
+        from zoneinfo import ZoneInfo
+
+        self.timezone = ZoneInfo("Asia/Shanghai")
+
+    def _get_session_config(self, sid):
+        return {"enable": True, "schedule_settings": {"quiet_hours": ""}}
+
+
+def tool_response(value=1):
+    return LLMResponse(
+        role="tool",
+        completion_text="",
+        tools_call_name=["echo"],
+        tools_call_args=[{"value": value}],
+        tools_call_ids=[f"call-{value}"],
+    )
