+        """
+        key = next((name, str(value)) for name, value in params.items())
+        async with self._detail_semaphore:
+            now = time.monotonic()
+            cached = self._detail_cache.get(key)
+            if cached is not None and cached[0] > now:
+                return cached[1]
+            if now < self._detail_limited_until:
+                raise BilibiliHttpError(412)
+            await asyncio.sleep(max(0.0, self._detail_next_request - now))
+            try:
+                data = await self._wbi_data(_VIEW_URL, params)
+            except BilibiliHttpError as exc:
+                if exc.status == 412:
+                    self._detail_limited_until = time.monotonic() + 5.0
+                raise
