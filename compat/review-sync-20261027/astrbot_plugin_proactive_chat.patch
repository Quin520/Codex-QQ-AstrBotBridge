+++ b/tests/test_config_save_consistency.py
@@ -0,0 +1,60 @@
+"""Check persistence and rollback through the actual console HTTP routes."""
+
+import importlib
+import json
+import sys
+import types
+from copy import deepcopy
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, patch
+
+import httpx
+import pytest
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("fail", [False, True])
+async def test_console_save_matches_runtime_and_disk(tmp_path, fail):
+    class Config(dict):
+        def save_config(self):
+            if fail:
+                raise OSError("fixture write failure")
+            path.write_text(json.dumps(dict(self)), encoding="utf-8")
+
+    original = {
+        "web_admin": {"password": ""},
+        "group_settings": {"enable": False},
+        "friend_settings": {"enable": False},
+        "unrelated": "retained",
+    }
+    path = tmp_path / "config.json"
+    path.write_text(json.dumps(original), encoding="utf-8")
+    config = Config(deepcopy(original))
+    package = types.ModuleType("proactive_config_test")
+    package.__path__ = [str(Path(__file__).resolve().parents[1])]
+    with patch.dict(sys.modules, {package.__name__: package}):
+        module = importlib.import_module("proactive_config_test.core.web_admin_server")
+        server = module.WebAdminServer(SimpleNamespace(config=config))
+        server._broadcast_update = AsyncMock()
+        async with httpx.AsyncClient(
+            transport=httpx.ASGITransport(app=server.app), base_url="http://test"
+        ) as client:
+            response = await client.post(
+                "/api/config", json={"group_settings": {"enable": True}}
+            )
+            visible = (await client.get("/api/config")).json()
+        disk = json.loads(path.read_text(encoding="utf-8"))
+        assert disk == dict(config)
+        assert visible["group_settings"] == disk["group_settings"]
+        assert disk["unrelated"] == "retained"
+        if fail:
+            assert response.status_code == 500
+            assert response.json()["ok"] is False
+            assert disk == original
+            server._broadcast_update.assert_not_awaited()
+        else:
+            assert response.status_code == 200
+            assert response.json()["ok"] is True
+            assert disk["group_settings"]["enable"] is True
+            server._broadcast_update.assert_awaited_once_with("config")
