+  vi.spyOn(HTMLCanvasElement.prototype, 'getContext').mockReturnValue(null);
+  let refresh: (() => void) | undefined;
+  const originalInterval = window.setInterval.bind(window);
+  vi.spyOn(window, 'setInterval').mockImplementation(((handler: TimerHandler, timeout?: number) => {
+    if (timeout === 60_000) {
+      refresh = handler as () => void;
+      return 123;
+    }
+    return originalInterval(handler, timeout);
+  }) as typeof window.setInterval);
+  Object.defineProperty(document, 'hidden', { configurable: true, value: false });
+  const rows = [
+    { id: 1, user_id: '123', group_id: '456', before: 0, after: 5, status: 'pending', message: 'A valid interaction' },
+    { id: 2, user_id: '123', group_id: '456', before: 1, after: 3, status: 'stale', stale_reason: 'Base value changed', message: 'Old evidence' },
+  ];
+  const payload = () => ({
+    persona_pending: { updates: [{ id: 'qq_profile_example', title: 'Member setting', review_source: 'qq_profile', before: 'Old setting', after: 'Proposed setting', evidence: [{ text: 'Explicit preference' }] }], total: 1, source_counts: {} },
+    persona_reviewed: { updates: [] }, style_reviews: { reviews: [], total: 0 },
+    jargon_pending: { jargon_list: [], total: 0 }, affection_reviews: { reviews: rows },
+    pending_total: 1 + rows.filter(row => row.status === 'pending').length,
+  });
+  const get = vi.fn(async () => JSON.parse(JSON.stringify(payload())));
+  const post = vi.fn(async (_path: string, body: { id: string; decision: string }) => {
+    rows.find(row => String(row.id) === body.id)!.status = body.decision === 'approve' ? 'approved' : 'rejected';
+    return { success: true, message: 'Saved' };
+  });
+  Object.defineProperty(window, 'AstrBotPluginPage', { configurable: true, value: {
+    ready: async () => ({}), apiGet: get, apiPost: post,
+  } });
