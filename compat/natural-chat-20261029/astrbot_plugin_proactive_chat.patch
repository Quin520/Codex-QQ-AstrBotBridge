@@ -0,0 +1,156 @@
+"""Exercise novelty decisions and actual scheduling without QQ delivery."""
+
+import importlib
+import time
+import unittest
+from copy import deepcopy
+
+import test_interval_scheduling as fixtures
+
+novelty = importlib.import_module("proactive_test.core.response_novelty")
+KEY = fixtures.KEY
+
+
+class NoveltyDecisionTests(unittest.TestCase):
+    def test_exact_punctuation_variants_repeat_but_different_short_meaning_does_not(
+        self,
+    ):
+        history = [{"sent_at": 100, "text": "今晚有人一起打游戏吗？"}]
+        self.assertTrue(
+            novelty.is_repeated_reply("今晚有人一起打游戏吗！", history, 101)
+        )
+        self.assertFalse(novelty.is_repeated_reply("今晚不想打游戏了", history, 101))
+
+    def test_near_copy_is_blocked_but_changed_score_is_kept(self):
+        sentence = (
+            "这局看到最后才发现真正的高手不是冲得最快的人而是最后还记得看地图的那个人啊"
+        )
+        history = [{"sent_at": 100, "text": sentence}]
+        self.assertTrue(novelty.is_repeated_reply(sentence[:-1] + "呀", history, 101))
+        self.assertFalse(
+            novelty.is_repeated_reply(
+                sentence + "比分变成2比1",
+                [{"sent_at": 100, "text": sentence + "比分变成1比1"}],
+                101,
+            )
+        )
+
+    def test_history_expires_is_bounded_and_future_records_are_not_used(self):
+        history = [{"sent_at": i, "text": "message " + str(i)} for i in range(10)]
+        self.assertEqual(len(novelty.recent_deliveries(history, 10)), 6)
+        self.assertEqual(novelty.recent_deliveries(history, 30000), [])
+        self.assertFalse(
+            novelty.is_repeated_reply("future", [{"sent_at": 20, "text": "future"}], 10)
+        )
+
+    def test_chinese_time_and_negation_changes_are_not_discarded_as_near_copies(self):
+        sentence = (
+            "今晚八点我会再来看看大家的排位战况顺便听听这把究竟是哪一条路被对面打穿了"
+        )
+        for changed in (
+            sentence.replace("八点", "九点"),
+            sentence.replace("我会", "我不会"),
+        ):
+            with self.subTest(changed=changed):
+                self.assertFalse(
+                    novelty.is_repeated_reply(
+                        changed, [{"sent_at": 100, "text": sentence}], 101
+                    )
+                )
+
+    def test_normalization_merges_both_scoped_histories_and_removes_duplicates(self):
+        first = {"sent_at": 1, "text": "first"}
+        second = {"sent_at": 2, "text": "second"}
+        self.assertEqual(
+            novelty.merge_deliveries([second], [first, second], 3), [first, second]
+        )
+
+
+class NoveltyFlowTests(unittest.IsolatedAsyncioTestCase):
+    asyncSetUp = fixtures.IntervalSchedulingTests.asyncSetUp
+    asyncTearDown = fixtures.IntervalSchedulingTests.asyncTearDown
+    start = fixtures.IntervalSchedulingTests.start
+
+    async def test_repeat_reschedules_without_delivery_count_or_history_write(self):
+        p = self.plugin
+        await self.start()
+        await p.check_and_chat(KEY)
+        self.assertEqual(len(self.deliveries), 1)
+        history = deepcopy(p.session_data[KEY]["recent_proactive_messages"])
+        p.context.conversation_manager.add_message_pair.reset_mock()
+        await p.check_and_chat(KEY)
+        self.assertEqual(len(self.deliveries), 1)
+        self.assertEqual(p.session_data[KEY]["unanswered_count"], 1)
+        self.assertEqual(p.session_data[KEY]["recent_proactive_messages"], history)
+        p.context.conversation_manager.add_message_pair.assert_not_awaited()
+        self.assertIsNotNone(p.scheduler.get_job(KEY))
+        self.assertIn("A short reply.", p._generate_llm_response.await_args.args[3])
+
+    async def test_failed_delivery_does_not_make_reply_a_repeat(self):
+        p = self.plugin
+        await self.start()
+        p._send_proactive_message.side_effect = None
+        p._send_proactive_message.return_value = False
+        await p.check_and_chat(KEY)
+        self.assertFalse(p.session_data[KEY].get("recent_proactive_messages"))
+        p._send_proactive_message.return_value = True
+        await p.check_and_chat(KEY)
+        self.assertEqual(len(p.session_data[KEY]["recent_proactive_messages"]), 1)
+
+    async def test_disabling_guard_retains_original_interval_behavior(self):
+        p = self.plugin
+        p.config["group_settings"]["avoid_repeated_messages"] = False
+        await self.start()
+        await p.check_and_chat(KEY)
+        await p.check_and_chat(KEY)
+        self.assertEqual(len(self.deliveries), 2)
+        self.assertEqual(p.session_data[KEY]["unanswered_count"], 2)
+
+    async def test_persisted_history_survives_normalization_and_does_not_cross_groups(
+        self,
+    ):
+        p = self.plugin
+        await self.start()
+        p.session_data[KEY]["recent_proactive_messages"] = [
+            {"sent_at": time.time(), "text": "A short reply."}
+        ]
+        restored = deepcopy(p.session_data)
+        p.session_data = restored
+        p._normalize_session_data()
+        await p.check_and_chat(KEY)
+        self.assertEqual(self.deliveries, [])
+        p.session_data["test:GroupMessage:777"] = p.session_data.pop(KEY)
+        await p.check_and_chat(KEY)
+        self.assertEqual(len(self.deliveries), 1)
+
+    async def test_media_or_already_delivered_tools_are_not_suppressed_as_text_repeats(
+        self,
+    ):
+        from astrbot.core.message.components import Image
+
+        for delivered in (False, True):
+            with self.subTest(direct_delivery=delivered):
+                p = self.plugin
+                p.session_data[KEY] = {
+                    "recent_proactive_messages": [
+                        {"sent_at": time.time(), "text": "A short reply."}
+                    ],
+                    "unanswered_count": 0,
+                }
+                p._extract_response_chain = lambda response, delivered=delivered: (
+                    []
+                    if delivered
+                    else [Image.fromURL("https://example.org/fixture.png")]
+                )
+                p._build_proactive_event = lambda sid, delivered=delivered: type(
+                    "Event",
+                    (),
+                    {
+                        "get_extra": lambda self, key, default=None: (
+                            delivered if key == "proactive_tool_delivered" else default
+                        )
+                    },
+                )()
+                before = p._send_proactive_message.await_count
+                await p.check_and_chat(KEY)
+                self.assertEqual(p._send_proactive_message.await_count, before + 1)
