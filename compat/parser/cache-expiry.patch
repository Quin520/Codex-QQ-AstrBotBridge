@@ -0,0 +1,92 @@
+"""Validate expiration and cache reuse without a network or QQ connection."""
+
+import importlib
+import os
+import sys
+import tempfile
+import time
+import unittest
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+from unittest.mock import Mock, patch
+
+PLUGIN = Path(__file__).resolve().parents[1]
+package = ModuleType("parser_cache_test")
+package.__path__ = [str(PLUGIN)]
+sys.modules[package.__name__] = package
+clean = importlib.import_module("parser_cache_test.core.clean")
+download = importlib.import_module("parser_cache_test.core.download")
+config = importlib.import_module("parser_cache_test.core.config")
+
+
+class CacheExpiryTests(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.cache = self.root / "cache"
+        self.cache.mkdir()
+        self.cfg = SimpleNamespace(
+            data_dir=self.root,
+            cache_dir=self.cache,
+            cache_retention_hours=24,
+            clean_cron="",
+        )
+        self.cleaner = clean.CacheCleaner.__new__(clean.CacheCleaner)
+        self.cleaner.cfg = self.cfg
+
+    def old_file(self, name):
+        path = self.cache / name
+        path.write_bytes(b"cache fixture")
+        old = time.time() - 25 * 3600
+        os.utime(path, (old, old))
+        return path
+
+    async def test_old_cache_removed_but_recent_and_private_data_retained(self):
+        old = self.old_file("old.mp4")
+        recent = self.cache / "recent.mp3"
+        recent.write_bytes(b"new")
+        cookie = self.root / "cookies.txt"
+        cookie.write_bytes(b"private fixture")
+        await self.cleaner._clean_plugin_cache()
+        self.assertFalse(old.exists())
+        self.assertTrue(recent.exists() and cookie.exists() and self.cache.is_dir())
+
+    async def test_cache_hit_refreshes_age_before_expiry(self):
+        path = self.old_file("hit.mp4")
+        downloader = download.Downloader.__new__(download.Downloader)
+        downloader.cfg = self.cfg
+        downloader.client = Mock()
+        returned = await downloader.streamd(
+            "https://example.com/video", file_name=path.name
+        )
+        self.assertEqual(returned, path)
+        self.assertLess(time.time() - path.stat().st_mtime, 3)
+        await self.cleaner._clean_plugin_cache()
+        self.assertTrue(path.exists())
+        downloader.client.get.assert_not_called()
+
+    async def test_locked_file_survives_and_other_file_expires(self):
+        locked = self.old_file("locked.mp4")
+        other = self.old_file("other.mp3")
+        unlink = Path.unlink
+
+        def guarded(path, *args, **kwargs):
+            if path == locked:
+                raise PermissionError("in use")
+            return unlink(path, *args, **kwargs)
+
+        with patch.object(Path, "unlink", guarded):
+            await self.cleaner._clean_plugin_cache()
+        self.assertTrue(locked.exists())
+        self.assertFalse(other.exists())
+
+    def test_blank_schedule_does_not_register_a_job(self):
+        self.cleaner.scheduler = Mock()
+        self.cleaner.register_task()
+        self.cleaner.scheduler.add_job.assert_not_called()
+
+    def test_retention_uses_typed_configuration(self):
+        node = config.PluginConfig.__new__(config.PluginConfig)
+        config.ConfigNode.__init__(node, {"cache_retention_hours": 48})
+        self.assertEqual(node.cache_retention_hours, 48)
